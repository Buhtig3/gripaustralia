---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUrl } from '../utils/url';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');

// Filter articles
const featuredGuides = articles.filter(a => ['what-is-grip-sport', 'mulletts-mandrel', 'gripper-rating-service', 'australian-grip-feats'].includes(a.slug));
---

<BaseLayout
  title="Grip Australia — Hand, Wrist & Forearm Strength Athletics"
  description="The home of Grip Sport in Australia. Strongfest sign-up, 2026 Nationals results, rules, Australian records, and competition calendar."
>
  <!-- Hero Video Section (100% Screen Width) -->
  <section class="relative w-full bg-black border-b border-slate-800 overflow-hidden">
    <div class="w-full relative aspect-video overflow-hidden bg-black flex items-center justify-center">
      <iframe
        src="https://player.vimeo.com/video/1135626571?autoplay=1&loop=1&autopause=0&muted=1&title=0&byline=0&portrait=0&controls=0"
        class="w-full h-full border-0 absolute inset-0"
        allow="autoplay; fullscreen"
        allowfullscreen
        title="Grip Australia Competitor Video"
      ></iframe>
    </div>
  </section>

  <!-- Prominent Hero Action Buttons -->
  <section class="bg-slate-950 py-10 px-4 border-b border-slate-800/80">
    <div class="max-w-xl mx-auto flex flex-col gap-4">
      <a
        href="https://www.eventbrite.com.au/e/strongfest-iv-tickets-1990312708890"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full text-center py-4 px-6 rounded-lg bg-zinc-700 hover:bg-orange-600 text-white font-black text-sm sm:text-base uppercase tracking-widest transition-all duration-200 shadow-lg hover:shadow-orange-600/30 transform hover:-translate-y-0.5 flex items-center justify-center gap-2 group"
      >
        <span>Strongfest IV Sign-up</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>

      <a
        href={getUrl('/2026-championship')}
        class="w-full text-center py-4 px-6 rounded-lg bg-zinc-700 hover:bg-orange-600 text-white font-black text-sm sm:text-base uppercase tracking-widest transition-all duration-200 shadow-lg hover:shadow-orange-600/30 transform hover:-translate-y-0.5 flex items-center justify-center gap-2 group"
      >
        <span>2026 Nationals Results</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Mission Statement Section -->
  <section class="relative overflow-hidden border-b border-slate-800 bg-gradient-to-b from-slate-900 to-slate-950 py-14">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:text-left">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-semibold uppercase tracking-wider mb-6">
          <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
          Sanctioned Grip Sport International (GSI) Rules
        </div>
        
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight">
          Forging Australian <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-amber-500">Grip Strength</span>
        </h1>
        
        <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
          Welcome to Grip Australia. We support athletes, gym venues, and contest organizers across the nation in tests of crushing, pinching, and thick-bar power.
        </p>

        <div class="mt-8 flex flex-wrap gap-4 justify-center sm:justify-start">
          <a
            href={getUrl('/what-is-grip-sport')}
            class="px-5 py-2.5 rounded-lg bg-orange-600 hover:bg-orange-500 text-white font-bold text-sm shadow-lg shadow-orange-600/30 transition-all transform hover:-translate-y-0.5"
          >
            What is Grip Sport?
          </a>
          <a
            href={getUrl('/competition-calendar')}
            class="px-5 py-2.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700 hover:border-slate-600 font-semibold text-sm transition-all"
          >
            Upcoming Events
          </a>
          <a
            href={getUrl('/australian-grip-feats')}
            class="px-5 py-2.5 rounded-lg bg-slate-900/60 hover:bg-slate-800 text-orange-400 border border-orange-500/30 font-semibold text-sm transition-all"
          >
            Australian Grip Feats
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Pillars Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
      <h2 class="text-xs font-bold text-orange-500 tracking-widest uppercase mb-2">Pillars of the Sport</h2>
      <p class="text-3xl font-extrabold text-white tracking-tight">Explore the Disciplines & Community</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <a href={getUrl('/what-is-grip-sport')} class="group bg-slate-900/70 border border-slate-800 hover:border-orange-500/50 p-6 rounded-xl transition-all hover:shadow-lg hover:shadow-orange-500/5 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-lg bg-orange-500/10 border border-orange-500/20 text-orange-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white group-hover:text-orange-400 mb-2 transition-colors">Understanding Grip Sport</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Learn the core contest dimensions: crushing grippers, pinch blocks, rolling thick handles, and vertical lift implements.
          </p>
        </div>
        <span class="mt-6 text-xs font-semibold text-orange-400 group-hover:underline inline-flex items-center gap-1">
          Read Guide &rarr;
        </span>
      </a>

      <a href={getUrl('/competition-calendar')} class="group bg-slate-900/70 border border-slate-800 hover:border-orange-500/50 p-6 rounded-xl transition-all hover:shadow-lg hover:shadow-orange-500/5 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-lg bg-orange-500/10 border border-orange-500/20 text-orange-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white group-hover:text-orange-400 mb-2 transition-colors">Competition Calendar</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Explore the national calendar: upcoming GSI-sanctioned events, Strongfest, and state championships across Australia.
          </p>
        </div>
        <span class="mt-6 text-xs font-semibold text-orange-400 group-hover:underline inline-flex items-center gap-1">
          View Calendar &rarr;
        </span>
      </a>

      <a href={getUrl('/australian-grip-feats')} class="group bg-slate-900/70 border border-slate-800 hover:border-orange-500/50 p-6 rounded-xl transition-all hover:shadow-lg hover:shadow-orange-500/5 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-lg bg-orange-500/10 border border-orange-500/20 text-orange-400 flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white group-hover:text-orange-400 mb-2 transition-colors">Australian Records & Feats</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Track official records, Inch dumbbell lifts, Blob lifts, and historic Australian strength performances.
          </p>
        </div>
        <span class="mt-6 text-xs font-semibold text-orange-400 group-hover:underline inline-flex items-center gap-1">
          View Feats &rarr;
        </span>
      </a>

    </div>
  </section>

  <!-- National Championships Archive -->
  <section class="border-t border-slate-800 bg-slate-900/40 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <h2 class="text-xs font-bold text-orange-500 tracking-widest uppercase mb-2">Championship History</h2>
          <p class="text-3xl font-black text-white">Australian Grip Sport Championships</p>
        </div>
        <p class="text-sm text-slate-400 mt-2 md:mt-0 max-w-md">
          Official results, scoresheets, podium photos, and pound-for-pound champion listings from past national meets.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href={getUrl('/2026-championship')} class="bg-slate-900 border border-slate-800 hover:border-orange-500/50 p-6 rounded-xl transition-all">
          <div class="text-xs font-semibold text-orange-400 uppercase tracking-wider mb-2">Latest Championship</div>
          <h3 class="text-xl font-bold text-white mb-2">2026 Nationals</h3>
          <p class="text-sm text-slate-400">
            Podium honors for Megan Galvin, Declan Wright, Sarah Rodwell, and Isaac Pitt.
          </p>
          <span class="mt-4 text-xs font-semibold text-orange-400 inline-block">See Results & Photos &rarr;</span>
        </a>

        <a href={getUrl('/2025-championship')} class="bg-slate-900 border border-slate-800 hover:border-orange-500/50 p-6 rounded-xl transition-all">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">National Championship</div>
          <h3 class="text-xl font-bold text-white mb-2">2025 Nationals</h3>
          <p class="text-sm text-slate-400">
            Multi-discipline showdown featuring the 2.25" Crusher, Napalm Nightmare, and Little Big Horn.
          </p>
          <span class="mt-4 text-xs font-semibold text-orange-400 inline-block">See Results & Photos &rarr;</span>
        </a>

        <a href={getUrl('/2024-championship')} class="bg-slate-900 border border-slate-800 hover:border-orange-500/50 p-6 rounded-xl transition-all">
          <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">National Championship</div>
          <h3 class="text-xl font-bold text-white mb-2">2024 Nationals</h3>
          <p class="text-sm text-slate-400">
            Inaugural benchmark events with national records set across men's and women's classes.
          </p>
          <span class="mt-4 text-xs font-semibold text-orange-400 inline-block">See Results & Photos &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Guides & Tools -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-10">
      <h2 class="text-xs font-bold text-orange-500 tracking-widest uppercase mb-2">Knowledge Base</h2>
      <p class="text-3xl font-black text-white">Guides, Tools & Community Resources</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {featuredGuides.map(item => (
        <a
          href={getUrl(`/${item.slug}`)}
          class="bg-slate-900/60 border border-slate-800 hover:border-slate-700 p-5 rounded-lg flex flex-col justify-between transition-colors hover:bg-slate-900"
        >
          <div>
            <h3 class="font-bold text-base text-white mb-2">{item.data.title}</h3>
            <p class="text-xs text-slate-400 line-clamp-3 leading-relaxed">
              {item.data.description}
            </p>
          </div>
          <span class="mt-4 text-xs font-semibold text-orange-400">Read Article &rarr;</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
