---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUrl } from '../utils/url';
import { getCollection } from 'astro:content';

const articles = await getCollection('articles');

// Featured Guides & Tools (Non-repetitive, high-utility selection)
const featuredGuides = [
  {
    title: "Beginner's Equipment Guide",
    slug: 'equipment-guide',
    badge: 'Essential Starter Gear',
    description: 'The definitive starter toolkit for grip competitions.'
  },
  {
    title: "Artie's Grip Gym Rating Service",
    slug: 'gripper-rating-service',
    badge: 'RGC Calibration • $10/$5',
    description: 'RGC ratings in Australia.'
  },
  {
    title: "Mullett's Mandrel Records",
    slug: 'mulletts-mandrel',
    badge: 'Australian Vertical Bar',
    description: 'Australia’s home-grown Vertical Bar implement. Check out current records and information.'
  },
  {
    title: "Interviews & Media Archive",
    slug: 'media',
    badge: 'Podcasts & Insights',
    description: 'Interviews with Australian grip athletes and competition coverage.'
  }
];
---

<BaseLayout
  title="Grip Australia"
  description="The new home of Grip Sport in Australia. Active content migration and new features underway."
>
  <!-- Site Migration & New Features Announcement Banner -->
  <aside
    id="migration-banner"
    class="w-full bg-[var(--bg-elevated)] border-b border-[var(--border-color)] py-3 px-4 sm:px-6 transition-colors duration-250 relative z-30"
    aria-label="Site update notification"
  >
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3 text-xs sm:text-sm">
      <div class="flex items-center gap-2.5 text-center md:text-left">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full font-mono text-xs font-bold uppercase tracking-wider bg-[var(--accent-gold)]/15 text-[var(--accent-gold)] border border-[var(--accent-gold)]/30 shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-gold)] animate-ping"></span>
          New Site
        </span>
        <p class="text-[var(--text-main)] font-medium leading-normal">
          <strong class="font-bold">Welcome to the new site for Grip Australia!</strong> Content migration and new features are being actively added.
        </p>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3 shrink-0 text-xs">
        <span class="text-[var(--text-muted)] hidden sm:inline">Notice anything?</span>
        <a
          href="https://instagram.com/pinch_bypinch"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 font-bold text-[var(--accent-gold)] hover:underline"
        >
          <span>DM @pinch_bypinch</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <span class="text-[var(--border-color)] hidden sm:inline">|</span>
        <a
          href="mailto:gripsportaustralia@gmail.com"
          class="font-semibold text-[var(--text-muted)] hover:text-[var(--text-main)] hover:underline"
        >
          gripsportaustralia@gmail.com
        </a>
        <span class="text-[var(--border-color)] hidden sm:inline">|</span>
        <a
          href={getUrl('/get-involved')}
          class="font-semibold text-[var(--text-muted)] hover:text-[var(--text-main)] hover:underline"
        >
          Reach Out &rarr;
        </a>
        <button
          id="dismiss-banner-btn"
          type="button"
          class="ml-1 p-1 rounded hover:bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-main)] transition-colors cursor-pointer"
          title="Dismiss notification"
          aria-label="Dismiss notification"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </aside>

  <!-- Hero Video Section (100% Screen Width) -->
  <section class="relative w-full bg-black border-b border-[var(--border-color)] overflow-hidden">
    <div class="w-full relative aspect-video overflow-hidden bg-black flex items-center justify-center">
      <iframe
        src="https://player.vimeo.com/video/1135626571?autoplay=1&loop=1&autopause=0&muted=1&title=0&byline=0&portrait=0&controls=0"
        class="w-full h-full border-0 absolute inset-0"
        allow="autoplay; fullscreen"
        allowfullscreen
        title="Grip Australia Competitor Video"
      ></iframe>
    </div>
  </section>

  <!-- Prominent Hero Action Buttons -->
  <section class="bg-[var(--bg-elevated)] py-10 px-4 border-b border-[var(--border-color)] transition-colors duration-250">
    <div class="max-w-xl mx-auto flex flex-col gap-4">
      <a
        href="https://www.eventbrite.com.au/e/strongfest-iv-tickets-1990312708890"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full text-center py-4 px-6 rounded-[var(--btn-radius)] bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-text)] font-display font-black text-base sm:text-lg uppercase tracking-widest transition-all duration-200 shadow-md hover:shadow-lg border border-[var(--accent-gold)]/40 transform hover:-translate-y-0.5 flex items-center justify-center gap-2 group"
      >
        <span>Strongfest IV Sign-up</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform text-[var(--accent-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>

      <a
        href={getUrl('/2026-championship')}
        class="w-full text-center py-4 px-6 rounded-[var(--btn-radius)] bg-[var(--bg-surface)] hover:bg-[var(--bg-base)] text-[var(--text-main)] font-display font-black text-base sm:text-lg uppercase tracking-widest transition-all duration-200 shadow-sm hover:shadow-md border border-[var(--border-color)] transform hover:-translate-y-0.5 flex items-center justify-center gap-2 group"
      >
        <span>2026 Nationals Results</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform text-[var(--accent-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Mission Statement Section -->
  <section class="relative overflow-hidden border-b border-[var(--border-color)] bg-[var(--bg-base)] py-14 transition-colors duration-250">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center sm:text-left">
      <div class="max-w-3xl">
        <div 
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider mb-6"
          style="background: var(--badge-bg); border: 1px solid var(--badge-border); color: var(--badge-text);"
        >
          <span class="w-2 h-2 rounded-full animate-pulse" style="background: var(--badge-text);"></span>
          Sanctioned Grip Sport International (GSI) Rules
        </div>
        
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-[var(--text-main)] font-display tracking-tight leading-tight uppercase">
          Forging Australian <span class="text-[var(--accent-gold)]">Grip Strength</span>
        </h1>
        
        <p class="mt-4 text-base sm:text-lg text-[var(--text-muted)] leading-relaxed">
          Welcome to Grip Australia. We support grip athletes, enthusiasts, gym venues and contest organisers across Australia.
        </p>

        <!-- New Site & Content Migration Notice Card -->
        <div class="mt-6 p-4 sm:p-5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)]/60 transition-colors shadow-sm text-left">
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold uppercase tracking-wider bg-[var(--accent-gold)]/15 text-[var(--accent-gold)] border border-[var(--accent-gold)]/30">
                  Site Update
                </span>
                <span class="text-xs font-bold text-[var(--text-main)] uppercase tracking-wide font-display">
                  Content Migration & New Features Underway
                </span>
              </div>
              <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">
                This is the new site for Grip Australia! Content migration and new features are actively being added. If you notice anything missing, broken, or have feedback, please reach out.
              </p>
            </div>
            <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 shrink-0 w-full sm:w-auto">
              <a
                href="https://instagram.com/pinch_bypinch"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full sm:w-auto text-center px-3.5 py-2 rounded-[var(--btn-radius)] bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-text)] font-accent font-bold text-xs uppercase tracking-wider transition-all shadow-sm border border-[var(--accent-gold)]/30 inline-flex items-center justify-center gap-1.5"
              >
                <span>Reach Out</span>
                <svg class="w-3.5 h-3.5 text-[var(--accent-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
              <a
                href="mailto:gripsportaustralia@gmail.com"
                class="w-full sm:w-auto text-center px-3.5 py-2 rounded-[var(--btn-radius)] bg-[var(--bg-elevated)] hover:bg-[var(--bg-base)] text-[var(--text-main)] font-accent font-bold text-xs uppercase tracking-wider transition-all border border-[var(--border-color)] inline-flex items-center justify-center"
              >
                Email
              </a>
            </div>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap gap-4 justify-center sm:justify-start">
          <a
            href={getUrl('/what-is-grip-sport')}
            class="px-5 py-2.5 rounded-[var(--btn-radius)] bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-text)] font-bold text-sm shadow-md transition-all transform hover:-translate-y-0.5 border border-[var(--accent-gold)]/30 font-accent uppercase tracking-wider"
          >
            What is Grip Sport?
          </a>
          <a
            href={getUrl('/competition-calendar')}
            class="px-5 py-2.5 rounded-[var(--btn-radius)] bg-[var(--bg-surface)] hover:bg-[var(--bg-elevated)] text-[var(--text-main)] border border-[var(--border-color)] font-semibold text-sm transition-all shadow-sm font-accent uppercase tracking-wider"
          >
            Upcoming Events
          </a>
          <a
            href={getUrl('/australian-grip-feats')}
            class="px-5 py-2.5 rounded-[var(--btn-radius)] bg-[var(--bg-surface)] hover:bg-[var(--bg-elevated)] text-[var(--accent-gold)] border border-[var(--accent-gold)]/40 font-semibold text-sm transition-all shadow-sm font-accent uppercase tracking-wider"
          >
            Australian Grip Feats
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Pillars Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12">
      <h2 class="text-xs font-bold text-[var(--accent-gold)] tracking-widest uppercase mb-2 font-accent">Pillars of the Sport</h2>
      <p class="text-3xl font-extrabold text-[var(--text-main)] font-display uppercase tracking-tight">Explore the Disciplines & Community</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <a href={getUrl('/what-is-grip-sport')} class="group bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] p-6 rounded-[var(--card-radius)] transition-all hover:shadow-lg flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-lg bg-[var(--bg-elevated)] border border-[var(--border-color)] text-[var(--accent-gold)] flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[var(--text-main)] font-display uppercase tracking-wider group-hover:text-[var(--accent-gold)] mb-2 transition-colors">Understanding Grip Sport</h3>
          <p class="text-sm text-[var(--text-muted)] leading-relaxed">
            Learn the core contest dimensions: crushing grippers, pinch blocks, rolling thick handles, and vertical lift implements.
          </p>
        </div>
        <span class="mt-6 text-xs font-semibold text-[var(--accent-gold)] group-hover:underline inline-flex items-center gap-1 font-accent tracking-wider uppercase">
          Read Guide &rarr;
        </span>
      </a>

      <a href={getUrl('/competition-calendar')} class="group bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] p-6 rounded-[var(--card-radius)] transition-all hover:shadow-lg flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-lg bg-[var(--bg-elevated)] border border-[var(--border-color)] text-[var(--accent-gold)] flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[var(--text-main)] font-display uppercase tracking-wider group-hover:text-[var(--accent-gold)] mb-2 transition-colors">Competition Calendar</h3>
          <p class="text-sm text-[var(--text-muted)] leading-relaxed">
            Explore the national calendar: upcoming GSI-sanctioned events, Strongfest, and state championships across Australia.
          </p>
        </div>
        <span class="mt-6 text-xs font-semibold text-[var(--accent-gold)] group-hover:underline inline-flex items-center gap-1 font-accent tracking-wider uppercase">
          View Calendar &rarr;
        </span>
      </a>

      <a href={getUrl('/australian-grip-feats')} class="group bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] p-6 rounded-[var(--card-radius)] transition-all hover:shadow-lg flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-lg bg-[var(--bg-elevated)] border border-[var(--border-color)] text-[var(--accent-gold)] flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-[var(--text-main)] font-display uppercase tracking-wider group-hover:text-[var(--accent-gold)] mb-2 transition-colors">Australian Records & Feats</h3>
          <p class="text-sm text-[var(--text-muted)] leading-relaxed">
            Track official records, Inch dumbbell lifts, Blob lifts, and historic Australian strength performances.
          </p>
        </div>
        <span class="mt-6 text-xs font-semibold text-[var(--accent-gold)] group-hover:underline inline-flex items-center gap-1 font-accent tracking-wider uppercase">
          View Feats &rarr;
        </span>
      </a>

    </div>
  </section>

  <!-- National Championships Archive -->
  <section class="border-t border-[var(--border-color)] bg-[var(--bg-elevated)] py-16 transition-colors duration-250">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10">
        <div>
          <h2 class="text-xs font-bold text-[var(--accent-gold)] tracking-widest uppercase mb-2 font-accent">Championship History</h2>
          <p class="text-3xl font-black text-[var(--text-main)] font-display uppercase">Australian Grip Sport Championships</p>
        </div>
        <p class="text-sm text-[var(--text-muted)] mt-2 md:mt-0 max-w-md">
          Official results, scoresheets, podium photos, and pound-for-pound champion listings from past national meets.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href={getUrl('/2026-championship')} class="bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] p-6 rounded-[var(--card-radius)] transition-all shadow-sm hover:shadow-md">
          <div class="text-xs font-semibold text-[var(--accent-gold)] uppercase tracking-wider mb-2 font-accent">Latest Championship</div>
          <h3 class="text-xl font-bold text-[var(--text-main)] font-display uppercase mb-2">2026 Nationals</h3>
          <p class="text-sm text-[var(--text-muted)]">
            Podium honors for Megan Galvin, Declan Wright, Sarah Rodwell, and Isaac Pitt.
          </p>
          <span class="mt-4 text-xs font-semibold text-[var(--accent-gold)] inline-block font-accent tracking-wider uppercase">See Results & Photos &rarr;</span>
        </a>

        <a href={getUrl('/2025-championship')} class="bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] p-6 rounded-[var(--card-radius)] transition-all shadow-sm hover:shadow-md">
          <div class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider mb-2 font-accent">National Championship</div>
          <h3 class="text-xl font-bold text-[var(--text-main)] font-display uppercase mb-2">2025 Nationals</h3>
          <p class="text-sm text-[var(--text-muted)]">
            Multi-discipline showdown featuring the 2.25" Crusher, Napalm Nightmare, and Little Big Horn.
          </p>
          <span class="mt-4 text-xs font-semibold text-[var(--accent-gold)] inline-block font-accent tracking-wider uppercase">See Results & Photos &rarr;</span>
        </a>

        <a href={getUrl('/2024-championship')} class="bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] p-6 rounded-[var(--card-radius)] transition-all shadow-sm hover:shadow-md">
          <div class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider mb-2 font-accent">National Championship</div>
          <h3 class="text-xl font-bold text-[var(--text-main)] font-display uppercase mb-2">2024 Nationals</h3>
          <p class="text-sm text-[var(--text-muted)]">
            Inaugural benchmark events with national records set across men's and women's classes.
          </p>
          <span class="mt-4 text-xs font-semibold text-[var(--accent-gold)] inline-block font-accent tracking-wider uppercase">See Results & Photos &rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Guides & Tools -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-10">
      <h2 class="text-xs font-bold text-[var(--accent-gold)] tracking-widest uppercase mb-2 font-accent">Knowledge Base</h2>
      <p class="text-3xl font-black text-[var(--text-main)] font-display uppercase">Guides, Tools & Community Resources</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {featuredGuides.map(item => (
        <a
          href={getUrl(`/${item.slug}`)}
          class="bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] p-5 rounded-[var(--card-radius)] flex flex-col justify-between transition-all hover:shadow-md group"
        >
          <div>
            <span class="inline-block text-[10px] font-mono font-bold uppercase tracking-wider text-[var(--accent-gold)] bg-[var(--accent-gold)]/10 border border-[var(--accent-gold)]/20 px-2 py-0.5 rounded mb-2.5">
              {item.badge}
            </span>
            <h3 class="font-bold text-base text-[var(--text-main)] font-display uppercase mb-2 group-hover:text-[var(--accent-gold)] transition-colors">{item.title}</h3>
            <p class="text-xs text-[var(--text-muted)] line-clamp-3 leading-relaxed">
              {item.description}
            </p>
          </div>
          <span class="mt-4 text-xs font-semibold text-[var(--accent-gold)] font-accent tracking-wider uppercase group-hover:underline inline-flex items-center gap-1">
            Explore Guide &rarr;
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  // Banner dismiss logic
  const banner = document.getElementById('migration-banner');
  const dismissBtn = document.getElementById('dismiss-banner-btn');

  try {
    if (sessionStorage.getItem('ga-migration-banner-dismissed') === 'true') {
      banner?.classList.add('hidden');
    }
  } catch (e) {}

  dismissBtn?.addEventListener('click', () => {
    banner?.classList.add('hidden');
    try {
      sessionStorage.setItem('ga-migration-banner-dismissed', 'true');
    } catch (e) {}
  });
</script>
