---
import BaseLayout from '../layouts/BaseLayout.astro';
import GripRecordsTable from '../components/GripRecordsTable.astro';
import records from '../data/records.json';
import recordsMeta from '../data/records_meta.json';
import { getUrl } from '../utils/url';

const pageTitle = "Australian Grip Records — Official National Registry";
const pageDescription = "The official national registry of Australian grip sport records, sanctioned GSI benchmarks, implement specifications, and historical feats.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <article class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 transition-all">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-[var(--text-muted)] mb-6 font-mono" aria-label="Breadcrumb">
      <a href={getUrl('/')} class="hover:text-[var(--accent-gold)] transition-colors">Home</a>
      <span>/</span>
      <span class="text-[var(--text-main)] truncate font-semibold">Australian Grip Records</span>
    </nav>

    <!-- Page Header -->
    <header class="pb-8 mb-8 border-b border-[var(--border-color)]">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-[var(--accent-gold)]/15 text-[var(--accent-gold)] border border-[var(--accent-gold)]/30">
          Official Registry
        </span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono text-[var(--text-muted)] bg-[var(--bg-elevated)] border border-[var(--border-color)]">
          GSI Sanctioned
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-[var(--text-main)] font-display uppercase tracking-tight leading-tight">
        Australian Grip Records
      </h1>

      <p class="mt-4 text-lg text-[var(--text-muted)] leading-relaxed max-w-3xl">
        The official national honour roll and competition registry for Grip Sport International (GSI) benchmarks in Australia, tracking all-time heaviest lifts across sanctioned implements, weight divisions, and iconic strength feats.
      </p>

      <!-- Processing & Source Metadata Banner -->
      <div class="mt-6 p-4 sm:p-5 rounded-2xl bg-[var(--bg-elevated)] border border-[var(--border-color)] text-xs text-[var(--text-main)]">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <!-- Processing Date -->
          <div class="flex items-start gap-3">
            <div class="p-2 rounded-xl bg-[var(--bg-surface)] text-[var(--accent-gold)] border border-[var(--border-color)] shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <div class="text-[var(--text-subtle)] font-mono uppercase text-[10px] tracking-wider">Record Processing Date</div>
              <div class="font-bold font-mono text-sm text-[var(--text-main)] mt-0.5">{recordsMeta.processedDisplay}</div>
              <div class="text-[10px] text-[var(--text-muted)] mt-0.5 font-mono">Automated pipeline sync</div>
            </div>
          </div>

          <!-- Data Origin -->
          <div class="flex items-start gap-3">
            <div class="p-2 rounded-xl bg-[var(--bg-surface)] text-sky-400 border border-[var(--border-color)] shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
              </svg>
            </div>
            <div>
              <div class="text-[var(--text-subtle)] font-mono uppercase text-[10px] tracking-wider">Data Origin</div>
              <a 
                href={recordsMeta.sourceUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="font-bold text-sm text-[var(--accent-gold)] hover:underline flex items-center gap-1 mt-0.5"
              >
                <span>gripsport.org</span>
                <svg class="w-3 h-3 opacity-75" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
              <div class="text-[10px] text-[var(--text-muted)] mt-0.5">Grip Sport International (GSI)</div>
            </div>
          </div>

          <!-- Sanctioning Body -->
          <div class="flex items-start gap-3">
            <div class="p-2 rounded-xl bg-[var(--bg-surface)] text-emerald-400 border border-[var(--border-color)] shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div>
              <div class="text-[var(--text-subtle)] font-mono uppercase text-[10px] tracking-wider">Sanctioning Standards</div>
              <div class="font-bold text-sm text-[var(--text-main)] mt-0.5">GSI Calibrated</div>
              <div class="text-[10px] text-[var(--text-muted)] mt-0.5">Official scales & certified referees</div>
            </div>
          </div>

          <!-- Total Records -->
          <div class="flex items-start gap-3">
            <div class="p-2 rounded-xl bg-[var(--bg-surface)] text-amber-400 border border-[var(--border-color)] shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
            </div>
            <div>
              <div class="text-[var(--text-subtle)] font-mono uppercase text-[10px] tracking-wider">Current Registry</div>
              <div class="font-bold font-mono text-sm text-[var(--text-main)] mt-0.5">{recordsMeta.totalRecords} Records Indexed</div>
              <div class="text-[10px] text-[var(--text-muted)] mt-0.5 font-mono">{recordsMeta.menGsiRecords} Men • {recordsMeta.womenGsiRecords} Women • {recordsMeta.historicFeats} Feats</div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Context & Methodology Accordion / Explanatory Section -->
    <section class="mb-10 space-y-4">
      <div class="rounded-2xl border border-[var(--border-color)] bg-[var(--bg-elevated)] p-5 sm:p-6">
        <h2 class="text-base sm:text-lg font-bold uppercase tracking-wider text-[var(--text-main)] font-display flex items-center gap-2 mb-3">
          <svg class="w-5 h-5 text-[var(--accent-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Background & Governance
        </h2>
        <div class="prose-grip text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed space-y-3">
          <p>
            Grip Sport in Australia operates in alignment with <strong>Grip Sport International (GSI)</strong>, the global governing federation established to standardize competitive grip athletics. Unlike casual strength demonstrations, official grip contests mandate calibrated loading apparatus (such as World of Grip Euro Pinch, FBBC vertical bars, IronMind hubs, Napalm's Nightmare revolving handles, and calibrated axles).
          </p>
          <p>
            To qualify as an official Australian National Record, lifts must be performed in a recognized GSI competition, weighed on calibrated digital scales, officiated by qualified referees following strict lockout and descent protocols, and documented with unedited video proof.
          </p>
        </div>

        <div class="mt-6 pt-5 border-t border-[var(--border-color)]">
          <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--text-main)] font-mono mb-2">
            Data Ingestion Methodology & Assumptions
          </h3>
          <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs text-[var(--text-muted)]">
            <li class="p-3 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
              <strong class="text-[var(--text-main)] block mb-1">⚖️ Dual Gender Extraction:</strong>
              On <a href="https://gripsport.org/records" target="_blank" rel="noopener" class="underline hover:text-[var(--accent-gold)]">gripsport.org</a>, querying <code class="text-[11px]">gender=all</code> returns only the single maximum result per event across both sexes, which inadvertently omits women's national marks. Our pipeline explicitly ingests both Men (<code class="text-[11px]">gender=1</code>) and Women (<code class="text-[11px]">gender=2</code>) datasets to ensure complete representation.
            </li>
            <li class="p-3 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
              <strong class="text-[var(--text-main)] block mb-1">📊 Standardized Metrics:</strong>
              All records are stored as numerical values in kilograms (<code class="text-[11px]">weightKg</code>) to ensure clean mathematical sorting. Imperial pound equivalents are dynamically computed (<code class="text-[11px]">lbs = kg × 2.20462</code>) and can be toggled using the unit switch above the table.
            </li>
            <li class="p-3 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
              <strong class="text-[var(--text-main)] block mb-1">⏱️ Timed Holds:</strong>
              Endurance grip events (such as the IronMind Silver Bullet holds with Captains of Crush grippers, and the 78kg Inch Dumbbell hold) measure duration under tension rather than load, and are calibrated numerically in seconds (<code class="text-[11px]">sec</code>).
            </li>
            <li class="p-3 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)]">
              <strong class="text-[var(--text-main)] block mb-1">🔨 Mullet's Mandrel Separation:</strong>
              Full rankings across all 22 Australian mandrel lifters are kept on the dedicated <a href={getUrl('/mulletts-mandrel')} class="underline hover:text-[var(--accent-gold)]">Mullet's Mandrel page</a>. Only the top record in each class (Henry Mullett 133.55kg & Sarah Rodwell 53.80kg) is incorporated into this central registry.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- The Interactive Sortable / Filterable Records Table -->
    <GripRecordsTable records={records as any} />

    <!-- Related Exploration Footer Links -->
    <section class="mt-16 pt-8 border-t border-[var(--border-color)]">
      <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--accent-gold)] font-display mb-4">
        Explore Related Grip Archives
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <a 
          href={getUrl('/australian-grip-feats')}
          class="p-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-elevated)] hover:border-[var(--accent-gold)] transition-colors group"
        >
          <div class="font-bold text-[var(--text-main)] group-hover:text-[var(--accent-gold)] transition-colors flex items-center justify-between">
            <span>Australian Grip Feats</span>
            <span>→</span>
          </div>
          <p class="text-[var(--text-muted)] mt-1">
            Historic honour rolls for the Thomas Inch Dumbbell, York Blob, and Captains of Crush #3.
          </p>
        </a>

        <a 
          href={getUrl('/mulletts-mandrel')}
          class="p-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-elevated)] hover:border-[var(--accent-gold)] transition-colors group"
        >
          <div class="font-bold text-[var(--text-main)] group-hover:text-[var(--accent-gold)] transition-colors flex items-center justify-between">
            <span>Mullet's Mandrel Rankings</span>
            <span>→</span>
          </div>
          <p class="text-[var(--text-muted)] mt-1">
            Complete digitized leaderboards for Henry Mullett's iconic Australian blacksmith-inspired tool.
          </p>
        </a>

        <a 
          href={getUrl('/competition-calendar')}
          class="p-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-elevated)] hover:border-[var(--accent-gold)] transition-colors group"
        >
          <div class="font-bold text-[var(--text-main)] group-hover:text-[var(--accent-gold)] transition-colors flex items-center justify-between">
            <span>Upcoming Competitions</span>
            <span>→</span>
          </div>
          <p class="text-[var(--text-muted)] mt-1">
            Official calendar of Australian championship qualifiers and record-breaker meets.
          </p>
        </a>
      </div>
    </section>

  </article>
</BaseLayout>
