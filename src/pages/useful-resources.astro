            <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-3">
              The promoter must email Jedd Johnson (<a href="mailto:jedd.diesel@gmail.com" class="text-[var(--accent-gold)] underline">jedd.diesel@gmail.com</a>) with complete event specifications:
            </p>
            <ul class="text-[11px] font-mono space-y-1 text-[var(--text-main)] bg-[var(--bg-elevated)] p-3 rounded-lg border border-[var(--border-color)]">
              <li>&bull; Name of Contest</li>
              <li>&bull; Contest Date</li>
              <li>&bull; Promoter's Name & Email</li>
              <li>&bull; Venue Location & Address</li>
              <li>&bull; Entry Form & Info Link</li>
              <li>&bull; Proposed Events & Implements</li>
            </ul>
          </div>
          <p class="text-[10px] text-[var(--text-muted)] mt-3">Promoter should submit well in advance of contest date.</p>
        </div>

        <!-- Step 2 Tiers -->
