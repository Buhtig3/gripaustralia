---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUrl } from '../utils/url';
import { getCompetitionsWithStatus } from '../utils/competitions';

const pageTitle = "Competition Calendar | Grip Australia";
const pageDescription = "Australian grip sport competition calendar: upcoming GSI-sanctioned events, state challenges, entry dates, and contest archives.";

const { upcoming, past } = getCompetitionsWithStatus();
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-[var(--text-muted)] mb-6 font-mono" aria-label="Breadcrumb">
      <a href={getUrl('/')} class="hover:text-[var(--accent-gold)] transition-colors">Home</a>
      <span>/</span>
      <span class="text-[var(--text-main)] truncate font-semibold">Competition Calendar</span>
    </nav>

    <!-- Page Header -->
    <header class="pb-8 mb-10 border-b border-[var(--border-color)]">
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-[var(--accent-gold)]/15 text-[var(--accent-gold)] border border-[var(--accent-gold)]/30">
          GSI Sanctioned Calendar
        </span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono text-[var(--text-muted)] bg-[var(--bg-elevated)] border border-[var(--border-color)]">
          Australia
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-[var(--text-main)] font-display uppercase tracking-tight leading-tight">
        Competition Calendar
      </h1>

      <p class="mt-4 text-lg text-[var(--text-muted)] leading-relaxed max-w-3xl">
        Australian competitions and records conducted under Grip Sport International (GSI) rules and partner sanctioning. Track upcoming contests, entry dates, and contest archives.
      </p>
    </header>

    <div class="space-y-14">

      <!-- UPCOMING COMPETITIONS SECTION -->
      <section id="upcoming">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6 pb-3 border-b border-[var(--border-color)]">
          <div>
            <h2 class="text-2xl font-black text-[var(--text-main)] m-0 tracking-tight flex items-center gap-2">
              <svg class="w-6 h-6 text-[var(--accent-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Upcoming Competitions
            </h2>
            <p class="text-sm text-[var(--text-muted)] mt-1 mb-0">Scheduled Australian GSI and partner events.</p>
          </div>
          <span class="inline-flex items-center self-start sm:self-auto px-3 py-1 rounded-full text-xs font-semibold bg-[var(--accent-gold)]/15 text-[var(--accent-gold)] border border-[var(--accent-gold)]/30 font-mono">
            Season 2026 - 2027
          </span>
        </div>

        {upcoming.length === 0 ? (
          <div class="p-8 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-color)] text-center">
            <p class="text-[var(--text-muted)] text-sm m-0">No upcoming competitions are currently scheduled. Check back soon or register a new event.</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {upcoming.map((event) => (
              <div class="bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)]/50 rounded-2xl p-6 transition-all duration-200 flex flex-col justify-between shadow-lg relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-24 h-24 bg-[var(--accent-gold)]/5 rounded-bl-full pointer-events-none"></div>
                <div>
                  <div class="flex items-center justify-between gap-2 mb-4">
                    {event.computedStatus === 'registration_open' ? (
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        Registration Open
                      </span>
                    ) : event.computedStatus === 'cancelled' ? (
                      <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
                        Cancelled
                      </span>
                    ) : (
                      <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-[var(--bg-elevated)] text-[var(--text-muted)] border border-[var(--border-color)]">
                        Scheduled
                      </span>
                    )}
                    <span class="text-xs font-mono text-[var(--text-muted)]">{event.location}</span>
                  </div>

                  <h3 class="text-2xl font-black text-[var(--text-main)] m-0 tracking-tight group-hover:text-[var(--accent-gold)] transition-colors">
                    {event.title}
                  </h3>

                  <div class="mt-5 space-y-2.5 text-sm">
                    <div class="flex items-center gap-2.5 text-[var(--text-main)]">
                      <svg class="w-4 h-4 text-[var(--accent-gold)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                      <span class="font-semibold text-[var(--text-main)]">{event.formattedDate}</span>
                    </div>
                    {event.time && (
                      <div class="flex items-center gap-2.5 text-[var(--text-muted)]">
                        <svg class="w-4 h-4 text-[var(--text-subtle)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>{event.time}</span>
                      </div>
                    )}
                    <div class="flex items-center gap-2.5 text-[var(--text-muted)]">
                      <svg class="w-4 h-4 text-[var(--text-subtle)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                      <span>{event.venue}</span>
                    </div>
                    {event.description && (
                      <p class="text-xs text-[var(--text-muted)] pt-2 leading-relaxed m-0 border-t border-[var(--border-color)]">
                        {event.description}
                      </p>
                    )}
                  </div>
                </div>

                <div class="mt-6 pt-4 border-t border-[var(--border-color)]">
                  {event.computedStatus === 'registration_open' && event.registrationUrl ? (
                    <a
                      href={event.registrationUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="no-underline w-full py-3 px-4 rounded-xl bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-text)] font-bold text-sm tracking-wider uppercase transition-all duration-200 shadow-md flex items-center justify-center gap-2 group/btn"
                    >
                      <span>Register Now</span>
                      <svg class="w-4 h-4 transform group-hover/btn:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                    </a>
                  ) : event.computedStatus === 'cancelled' ? (
                    <div class="w-full py-3 px-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 font-semibold text-sm tracking-wider uppercase flex items-center justify-center gap-2 cursor-default">
                      <span>Event Cancelled</span>
                    </div>
                  ) : (
                    <div class="w-full py-3 px-4 rounded-xl bg-[var(--bg-elevated)] border border-[var(--border-color)] text-[var(--text-muted)] font-semibold text-sm tracking-wider uppercase flex items-center justify-center gap-2 cursor-default">
                      <span>Entry Details Coming Soon</span>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        )}
      </section>

      <!-- PAST COMPETITIONS ARCHIVE SECTION -->
      {past.length > 0 && (
        <section id="past-competitions">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-6 pb-3 border-b border-[var(--border-color)]">
            <div>
              <h2 class="text-2xl font-black text-[var(--text-main)] m-0 tracking-tight flex items-center gap-2">
                <svg class="w-6 h-6 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                </svg>
                Past Competitions
              </h2>
              <p class="text-sm text-[var(--text-muted)] mt-1 mb-0">Completed Australian grip contests and scorecards.</p>
            </div>
            <span class="inline-flex items-center self-start sm:self-auto px-3 py-1 rounded-full text-xs font-semibold bg-[var(--bg-elevated)] text-[var(--text-muted)] border border-[var(--border-color)] font-mono">
              Archived
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {past.map((event) => (
              <div class="bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-2xl p-6 flex flex-col justify-between shadow-sm relative overflow-hidden">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-4">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-bold uppercase tracking-wider bg-[var(--bg-elevated)] text-[var(--text-muted)] border border-[var(--border-color)]">
                      Completed
                    </span>
                    <span class="text-xs font-mono text-[var(--text-muted)]">{event.location}</span>
                  </div>

                  <h3 class="text-2xl font-black text-[var(--text-main)] m-0 tracking-tight">
                    {event.title}
                  </h3>

                  <div class="mt-4 space-y-2 text-sm text-[var(--text-muted)]">
                    <div class="flex items-center gap-2">
                      <svg class="w-4 h-4 text-[var(--text-subtle)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                      <span>{event.formattedDate}</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <svg class="w-4 h-4 text-[var(--text-subtle)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                      <span>{event.venue}</span>
                    </div>
                    {event.description && (
                      <p class="text-xs text-[var(--text-muted)] pt-2 leading-relaxed m-0 border-t border-[var(--border-color)]">
                        {event.description}
                      </p>
                    )}
                  </div>
                </div>

                <div class="mt-6 pt-4 border-t border-[var(--border-color)]">
                  {event.resultsUrl ? (
                    <a
                      href={event.resultsUrl}
                      class="no-underline w-full py-2.5 px-4 rounded-xl bg-[var(--bg-elevated)] hover:bg-[var(--bg-base)] text-[var(--text-main)] border border-[var(--border-color)] font-semibold text-xs tracking-wider uppercase flex items-center justify-center gap-2 transition-colors"
                    >
                      <span>View Results</span>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </a>
                  ) : (
                    <div class="text-xs text-[var(--text-subtle)] font-mono text-center py-2">
                      Results pending organiser publication
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Featured Record Lift Highlight -->
      <section class="bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-2xl p-6 sm:p-8 shadow-xl">
        <div class="flex items-center gap-2 text-xs font-bold text-[var(--accent-gold)] tracking-wider uppercase mb-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
          </svg>
          <span>Featured Record Lift</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-black text-[var(--text-main)] m-0 tracking-tight">
          Sarah Rodwell: Class Record at GSI Grip Challenge Canberra
        </h2>
        <p class="text-[var(--text-muted)] text-sm mt-2 mb-4 leading-relaxed">
          Sarah Rodwell setting an Australian class record at the GSI Grip Challenge Canberra, demonstrating hand, finger, and wrist power.
        </p>

        <div class="video-wrapper">
          <iframe src="https://player.vimeo.com/video/861903100?h=fb9fae452a&title=0&byline=0&portrait=0" title="Sarah Rodwell with class record set at GSI Grip Challenge Canberra" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
        </div>
      </section>

      <!-- Call to Action / Hosting Banner -->
      <section class="bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left shadow-lg">
        <div>
          <h3 class="text-lg font-bold text-[var(--text-main)] m-0">Hosting a Grip Sport Event in Your State?</h3>
          <p class="text-sm text-[var(--text-muted)] m-0 mt-1">Get your competition sanctioned with Grip Sport International (GSI) and listed on the national Grip Australia calendar. Access official rules, seasoning standards, and the standardised results spreadsheet from <a href="https://gripsportint.com/resources" target="_blank" rel="noopener noreferrer" class="text-[var(--accent-gold)] underline">gripsportint.com/resources</a>.</p>
        </div>
        <div class="flex items-center gap-3 flex-shrink-0">
          <a
            href={getUrl('/get-involved')}
            class="no-underline inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-text)] text-xs font-bold uppercase tracking-wider transition-colors flex-shrink-0 shadow-md"
          >
            <span>Meet Director Guide</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>
      </section>

    </div>
  </article>
</BaseLayout>
