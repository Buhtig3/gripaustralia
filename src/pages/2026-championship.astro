  { rank: 3, name: 'Lachlan Simms', division: 'Mens 120k+', nn: '196.20 kg', pinch: '122.00 kg', cannon: '103.30 kg', totalScore: '4.55', p4p: '2.68', honor: '🥉 3rd Overall', p4pRank: null },
  { rank: 4, name: 'Joseph Hodgson', division: 'Mens 105k', nn: '176.20 kg', pinch: '122.00 kg', cannon: '103.30 kg', totalScore: '4.45', p4p: '3.83', honor: '4th', p4pRank: null },
  { rank: 5, name: 'Christo Swart', division: 'Mens 105k', nn: '181.20 kg', pinch: '107.00 kg', cannon: '103.30 kg', totalScore: '4.30', p4p: '3.73', honor: '5th', p4pRank: null },
  { rank: 6, name: 'Glen Krutli', division: 'Mens 120k', nn: '151.20 kg', pinch: '107.00 kg', cannon: '93.30 kg', totalScore: '4.23', p4p: '2.95', honor: '6th', p4pRank: null },
