  { rank: 9, name: 'Jayden Osmialowski', division: 'Mens 83k', nn: '141.20 kg', pinch: '97.00 kg', cannon: '93.30 kg', totalScore: '3.75', p4p: '4.34', honor: '9th', p4pRank: '3rd P4P' },
  { rank: 10, name: 'Jackson Willows', division: 'Mens 105k', nn: '141.20 kg', pinch: '97.00 kg', cannon: '83.30 kg', totalScore: '3.58', p4p: '3.34', honor: '10th', p4pRank: null },
  { rank: 11, name: 'Glenn Hunter', division: 'Mens 120k+', nn: '131.20 kg', pinch: '92.00 kg', cannon: '93.30 kg', totalScore: '3.51', p4p: '2.45', honor: '11th', p4pRank: null },
  { rank: 12, name: 'Benjamin Kleinberg', division: 'Mens 105k', nn: '125.20 kg', pinch: '77.00 kg', cannon: '83.30 kg', totalScore: '3.28', p4p: '2.88', honor: '12th', p4pRank: null },
  { rank: 13, name: 'Dylan Thomson', division: 'Mens 120k+', nn: '125.20 kg', pinch: '82.00 kg', cannon: '73.30 kg', totalScore: '3.21', p4p: '1.72', honor: '13th', p4pRank: null },
