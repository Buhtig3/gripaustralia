  { rank: 16, name: 'Matthew Shaw', division: 'Mens 74k', nn: '110.20 kg', pinch: '67.00 kg', cannon: '73.30 kg', totalScore: '2.91', p4p: '3.60', honor: '16th', p4pRank: null },
  { rank: 17, name: 'Frazer Gayapersad', division: 'Mens 120k+', nn: '151.20 kg', pinch: '77.00 kg', cannon: '-', totalScore: '2.83', p4p: '1.64', honor: '17th', p4pRank: null },
