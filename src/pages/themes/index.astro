          { name: 'Spinifex', hex: '#5d7a68' }
        ]
      },
      'theme-4': {
        name: 'Theme 04: Heritage Gold & Athletic Club (Dark Prestige) ⭐',
        vibe: 'Historic Strongman Pedigree • Midnight Evergreen • Trophy Gold Leaf',
        dotColor: '#d4af37',
        fonts: ['Display: Cinzel', 'Accent: Outfit', 'Body: Plus Jakarta Sans'],
        swatches: [
          { name: 'Midnight Green', hex: '#08130f' },
          { name: 'Federation Slate', hex: '#0f221b' },
          { name: 'Trophy Gold', hex: '#d4af37' },
          { name: 'Archival White', hex: '#fcf9f2' },
          { name: 'Laurel Green', hex: '#254a3c' }
        ]
      },
      'theme-3': {
        name: 'Theme 03: Sandstone & Coastal Iron (Light) ☀️',
        vibe: 'Sunlit Australian Coast • Ocean Cobalt Ink • Coastal Gold • Warm Sandstone Linen',
        dotColor: '#d97706',
        fonts: ['Display: Outfit', 'Accent: Barlow Condensed', 'Body: Plus Jakarta Sans'],
        swatches: [
          { name: 'Sandstone Canvas', hex: '#f7f4ed' },
          { name: 'Pure Vellum', hex: '#ffffff' },
          { name: 'Pacific Navy', hex: '#0f2942' },
          { name: 'Coastal Gold', hex: '#d97706' },
          { name: 'Limestone Edge', hex: '#dfd7c5' }
        ]
      },
      'theme-5': {
        name: 'Theme 05: Vintage Archival Gazette (Light) 📜',
        vibe: 'Championship Sporting Broadsheet • Ivory Paper • Letterpress Ink • Antique Gold Seal',
        dotColor: '#b4832c',
        fonts: ['Display: Cinzel', 'Accent: Cinzel Decorative', 'Body: Plus Jakarta Sans'],
        swatches: [
          { name: 'Archival Ivory', hex: '#faf6ee' },
          { name: 'Crisp Surface', hex: '#ffffff' },
          { name: 'Foundry Ink', hex: '#1c1a17' },
          { name: 'Medal Gold', hex: '#b4832c' },
          { name: 'Antique Rule', hex: '#dcd2be' }
        ]
      },
      'theme-1': {
        name: 'Theme 01: Raw Iron & Mag Chalk (Dark)',
        vibe: 'Heavy Foundry • Obsidian Slate • Forge Amber • Mag Chalk Mist',
        dotColor: '#ff5500',
        fonts: ['Display: Syne', 'Accent: Barlow Condensed', 'Body: Plus Jakarta Sans'],
        swatches: [
          { name: 'Base', hex: '#0e1013' },
          { name: 'Surface', hex: '#16191f' },
          { name: 'Border', hex: '#2a2f3a' },
          { name: 'Forge Orange', hex: '#ff5500' },
          { name: 'Chalk White', hex: '#f4f4f6' }
        ]
      }
    };

    function switchTheme(themeKey, btnElement) {
      document.body.setAttribute('data-theme', themeKey);
      
      document.querySelectorAll('.theme-nav-buttons .theme-btn').forEach(btn => {
        if (!btn.classList.contains('pair-quick-toggle')) {
          btn.classList.remove('active');
        }
      });
      if (btnElement && !btnElement.classList.contains('pair-quick-toggle')) {
        btnElement.classList.add('active');
      }

      updateInspector(themeKey);
      updateGripModeBadge(themeKey);

      try {
        localStorage.setItem('ga-preferred-mode', themeKey);
      } catch (e) {}
    }

    function toggleGripLightDarkMode(event) {
      if (event) event.preventDefault();

      const currentTheme = document.body.getAttribute('data-theme');
      
      const icons = [document.getElementById('header-grip-logo'), document.getElementById('footer-grip-logo')];
      icons.forEach(icon => {
        if (icon) {
          icon.classList.add('crushing');
          setTimeout(() => icon.classList.remove('crushing'), 350);
        }
      });

      let nextTheme = 'theme-2';
      if (currentTheme === 'theme-6') {
        nextTheme = 'theme-2';
      } else if (currentTheme === 'theme-2') {
        nextTheme = 'theme-6';
      } else {
        nextTheme = (currentTheme === 'theme-3' || currentTheme === 'theme-5') ? 'theme-2' : 'theme-6';
      }

      const targetBtn = Array.from(document.querySelectorAll('.theme-nav-buttons .theme-btn'))
        .find(btn => btn.getAttribute('onclick')?.includes(nextTheme));
      
      switchTheme(nextTheme, targetBtn);
    }

    function updateGripModeBadge(themeKey) {
      const badge = document.getElementById('header-mode-badge');
      const logoBtn = document.getElementById('header-grip-logo');
      const pairBtnIcon = document.getElementById('pair-btn-icon');
      
      if (themeKey === 'theme-6') {
        if (badge) badge.innerHTML = `<span class="mode-icon">☀️</span> <span class="mode-text">LIGHT (CALIBRATED)</span>`;
        if (logoBtn) logoBtn.setAttribute('data-tooltip', '☀️ Light Mode (Calibrated) • Click logo to crush into Outback Dark');
        if (pairBtnIcon) pairBtnIcon.textContent = '☀️ (Light active)';
      } else if (themeKey === 'theme-2') {
        if (badge) badge.innerHTML = `<span class="mode-icon">🌙</span> <span class="mode-text">DARK (OUTBACK)</span>`;
        if (logoBtn) logoBtn.setAttribute('data-tooltip', '🌙 Dark Mode (Outback) • Click logo to crush into Calibrated Light');
        if (pairBtnIcon) pairBtnIcon.textContent = '🌙 (Dark active)';
      } else if (themeKey === 'theme-3' || themeKey === 'theme-5') {
        if (badge) badge.innerHTML = `<span class="mode-icon">☀️</span> <span class="mode-text">LIGHT</span>`;
        if (logoBtn) logoBtn.setAttribute('data-tooltip', 'Click logo to toggle Calibrated Light ↔ Outback Dark');
        if (pairBtnIcon) pairBtnIcon.textContent = '☀️/🌙';
      } else {
        if (badge) badge.innerHTML = `<span class="mode-icon">🌙</span> <span class="mode-text">DARK</span>`;
        if (logoBtn) logoBtn.setAttribute('data-tooltip', 'Click logo to toggle Calibrated Light ↔ Outback Dark');
        if (pairBtnIcon) pairBtnIcon.textContent = '☀️/🌙';
      }
    }

    function applyAndSwitch(themeKey) {
      const targetBtn = Array.from(document.querySelectorAll('.theme-nav-buttons .theme-btn'))
        .find(btn => btn.getAttribute('onclick')?.includes(themeKey));
      switchTheme(themeKey, targetBtn);
      setViewMode('live');
    }

    function setViewMode(mode) {
      const liveView = document.getElementById('live-view');
      const galleryView = document.getElementById('gallery-view');
      const btnLive = document.getElementById('btn-mode-live');
      const btnGallery = document.getElementById('btn-mode-gallery');

      if (mode === 'live') {
        liveView.style.display = 'block';
        galleryView.style.display = 'none';
        btnLive.classList.add('active');
        btnGallery.classList.remove('active');
      } else {
        liveView.style.display = 'none';
        galleryView.style.display = 'block';
        btnLive.classList.remove('active');
        btnGallery.classList.add('active');
      }
    }

    function updateInspector(themeKey) {
      const data = themeData[themeKey];
      if (!data) return;

      const nameEl = document.getElementById('meta-theme-name');
      nameEl.innerHTML = `<span style="width: 8px; height: 8px; border-radius: 50%; background: ${data.dotColor};"></span><span>${data.name}</span>`;

      const vibeEl = document.getElementById('meta-theme-vibe');
      vibeEl.textContent = data.vibe;

      const swatchesEl = document.getElementById('palette-swatches');
      swatchesEl.innerHTML = data.swatches.map(s => `
        <div class="swatch-item" title="Click to copy ${s.hex}" onclick="copyHex('${s.hex}')">
          <span class="swatch-color-box" style="background: ${s.hex};"></span>
          <span>${s.name}: ${s.hex}</span>
        </div>
      `).join('');

      const fontsEl = document.getElementById('font-stack-pills');
      fontsEl.innerHTML = data.fonts.map(f => `
        <span class="font-pill">${f}</span>
      `).join('');
    }

    function copyHex(hex) {
      navigator.clipboard.writeText(hex).then(() => {
        alert('Copied ' + hex + ' to clipboard!');
      }).catch(() => {});
    }

    const savedTheme = localStorage.getItem('ga-preferred-mode') || 'theme-6';
    const initBtn = Array.from(document.querySelectorAll('.theme-nav-buttons .theme-btn'))
      .find(btn => btn.getAttribute('onclick')?.includes(savedTheme));
    switchTheme(savedTheme, initBtn);
  </script>
</body>
</html>
