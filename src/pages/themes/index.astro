---
// Standalone alternative themes showcase and snapshot page
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grip Australia — Alternative Themes Snapshot & Interactive Showcase</title>

  <!-- Google Fonts for all 6 Theme Archetypes -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Bebas+Neue&family=Cinzel:wght@600;700;900&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,600;0,9..40,700;1,9..40,400&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&family=Outfit:wght@400;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">

  <style is:inline>
    /* ==========================================================================
       CSS VARIABLES & THEME DEFINITIONS
       ========================================================================== */
    :root {
      --transition-smooth: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* THEME 01: Raw Iron & Mag Chalk (Dark / Heavy Foundry) */
    body[data-theme="theme-1"] {
      --bg-base: #0e1013;
      --bg-surface: #16191f;
      --bg-elevated: #1f232b;
      --border-color: #2a2f3a;
      --accent: #ff5500;
      --accent-hover: #ff7733;
      --accent-text: #ffffff;
      --text-main: #f4f4f6;
      --text-muted: #9da5b4;
      --font-display: 'Syne', sans-serif;
      --font-accent: 'Barlow Condensed', sans-serif;
      --font-body: 'Plus Jakarta Sans', sans-serif;
      --btn-radius: 4px;
      --card-radius: 8px;
      --box-shadow: 0 10px 30px -10px rgba(0,0,0,0.7), 0 0 1px 1px var(--border-color);
      --btn-shadow: 0 6px 20px rgba(255, 85, 0, 0.35);
      --bg-pattern: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
      --bg-pattern-size: 18px 18px;
      --badge-bg: rgba(255, 85, 0, 0.12);
      --badge-border: rgba(255, 85, 0, 0.3);
      --badge-text: #ff7733;
      --hero-overlay: radial-gradient(circle at 50% 0%, rgba(255, 85, 0, 0.1) 0%, transparent 60%);
    }

    /* THEME 02: Outback Ochre & Terra (Warm Dark / Australian Earth) ⭐ PRIMARY DARK PAIR */
    body[data-theme="theme-2"] {
      --bg-base: #141110;
      --bg-surface: #1e1917;
      --bg-elevated: #29221f;
      --border-color: #3d332f;
      --accent: #e05a2b;
      --accent-hover: #f06a3b;
      --accent-text: #ffffff;
      --text-main: #faf5ee;
      --text-muted: #ad9e96;
      --font-display: 'Bebas Neue', cursive;
      --font-accent: 'Space Grotesk', sans-serif;
      --font-body: 'DM Sans', sans-serif;
      --btn-radius: 6px;
      --card-radius: 10px;
      --box-shadow: 0 12px 32px -8px rgba(20, 10, 5, 0.8), 0 0 1px 1px var(--border-color);
      --btn-shadow: 0 6px 22px rgba(224, 90, 43, 0.35);
      --bg-pattern: radial-gradient(rgba(224, 90, 43, 0.05) 1px, transparent 1px);
      --bg-pattern-size: 24px 24px;
      --badge-bg: rgba(224, 90, 43, 0.14);
      --badge-border: rgba(224, 90, 43, 0.35);
      --badge-text: #e59b3c;
      --hero-overlay: radial-gradient(circle at 50% -10%, rgba(224, 90, 43, 0.18) 0%, transparent 60%);
    }

    /* THEME 03: Sandstone & Coastal Iron (LIGHT / Australian Coast & Outdoor Strength) */
    body[data-theme="theme-3"] {
      --bg-base: #f7f4ed;
      --bg-surface: #ffffff;
      --bg-elevated: #ede8dc;
      --border-color: #dfd7c5;
      --accent: #d97706;
      --accent-hover: #b45309;
      --accent-text: #ffffff;
      --text-main: #0f2942;
      --text-muted: #5c6f84;
      --font-display: 'Outfit', sans-serif;
      --font-accent: 'Barlow Condensed', sans-serif;
      --font-body: 'Plus Jakarta Sans', sans-serif;
      --btn-radius: 6px;
      --card-radius: 8px;
      --box-shadow: 0 10px 30px -10px rgba(15, 41, 66, 0.08), 0 0 1px 1px var(--border-color);
      --btn-shadow: 0 6px 20px rgba(217, 119, 6, 0.28);
      --bg-pattern: radial-gradient(rgba(217, 119, 6, 0.04) 1px, transparent 1px);
      --bg-pattern-size: 24px 24px;
      --badge-bg: rgba(217, 119, 6, 0.1);
      --badge-border: rgba(217, 119, 6, 0.3);
      --badge-text: #d97706;
      --hero-overlay: radial-gradient(circle at 85% 0%, rgba(217, 119, 6, 0.08) 0%, transparent 60%);
    }

    /* THEME 04: Heritage Gold & Athletic Club (Dark Prestige / Championship Federation) */
    body[data-theme="theme-4"] {
      --bg-base: #08130f;
      --bg-surface: #0f221b;
      --bg-elevated: #162f26;
      --border-color: #254a3c;
      --accent: #d4af37;
      --accent-hover: #e5bf45;
      --accent-text: #08130f;
      --text-main: #fcf9f2;
      --text-muted: #a3b5ab;
      --font-display: 'Cinzel', serif;
      --font-accent: 'Outfit', sans-serif;
      --font-body: 'Plus Jakarta Sans', sans-serif;
      --btn-radius: 4px;
      --card-radius: 6px;
      --box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), inset 0 0 0 1px var(--border-color);
      --btn-shadow: 0 6px 25px rgba(212, 175, 55, 0.28);
      --bg-pattern: radial-gradient(rgba(212, 175, 55, 0.04) 1px, transparent 1px);
      --bg-pattern-size: 20px 20px;
      --badge-bg: rgba(212, 175, 55, 0.12);
      --badge-border: rgba(212, 175, 55, 0.3);
      --badge-text: #d4af37;
      --hero-overlay: radial-gradient(circle at 50% 0%, rgba(212, 175, 55, 0.14) 0%, transparent 60%);
    }

    /* THEME 05: Vintage Archival Gazette (LIGHT / Championship Broadsheet & Ivory Vellum) */
    body[data-theme="theme-5"] {
      --bg-base: #faf6ee;
      --bg-surface: #ffffff;
      --bg-elevated: #f1ebe0;
      --border-color: #dcd2be;
      --accent: #b4832c;
      --accent-hover: #946a20;
      --accent-text: #ffffff;
      --text-main: #1c1a17;
      --text-muted: #635e55;
      --font-display: 'Cinzel', serif;
      --font-accent: 'Cinzel', serif;
      --font-body: 'Plus Jakarta Sans', sans-serif;
      --btn-radius: 4px;
      --card-radius: 6px;
      --box-shadow: 0 10px 30px -8px rgba(28, 26, 23, 0.08), 0 0 1px 1px var(--border-color);
      --btn-shadow: 0 6px 24px rgba(180, 131, 44, 0.25);
      --bg-pattern: radial-gradient(rgba(180, 131, 44, 0.04) 1px, transparent 1px);
      --bg-pattern-size: 20px 20px;
      --badge-bg: rgba(180, 131, 44, 0.12);
      --badge-border: rgba(180, 131, 44, 0.3);
      --badge-text: #b4832c;
      --hero-overlay: radial-gradient(circle at 50% 0%, rgba(180, 131, 44, 0.08) 0%, transparent 60%);
    }

    /* THEME 06: Calibrated Athletic Minimalism (LIGHT / Deep Eucalyptus & Wattle Gold) ⭐ PRIMARY LIGHT PAIR */
    body[data-theme="theme-6"] {
      --bg-base: #f8f9fa;
      --bg-surface: #ffffff;
      --bg-elevated: #f1f3f5;
      --border-color: #e2e8f0;
      --accent: #143024;
      --accent-hover: #0d2018;
      --accent-text: #ffffff;
      --accent-gold: #e5a93c;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --font-display: 'Barlow Condensed', sans-serif;
      --font-accent: 'Barlow Condensed', sans-serif;
      --font-body: 'Inter', sans-serif;
      --btn-radius: 4px;
      --card-radius: 6px;
      --box-shadow: 0 6px 24px -4px rgba(20, 48, 36, 0.07), 0 0 1px 1px var(--border-color);
      --btn-shadow: 0 4px 16px rgba(20, 48, 36, 0.25);
      --bg-pattern: radial-gradient(rgba(20, 48, 36, 0.035) 1px, transparent 1px);
      --bg-pattern-size: 20px 20px;
      --badge-bg: #e5a93c;
      --badge-border: #e5a93c;
      --badge-text: #143024;
      --hero-overlay: radial-gradient(circle at 50% 0%, rgba(20, 48, 36, 0.05) 0%, transparent 65%);
    }

    /* ==========================================================================
       GLOBAL BASE RESETS
       ========================================================================== */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-base);
      background-image: var(--bg-pattern);
      background-size: var(--bg-pattern-size);
      color: var(--text-main);
      font-family: var(--font-body);
      line-height: 1.6;
      transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
      overflow-x: hidden;
      min-height: 100vh;
      padding-bottom: 110px;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .tabular-nums {
      font-family: var(--font-body);
      font-variant-numeric: tabular-nums;
      font-feature-settings: "tnum";
    }

    /* ==========================================================================
       FLOATING CONTROLLER / THEME SWITCHER
       ========================================================================== */
    .theme-controller-bar {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(10, 10, 12, 0.94);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      padding: 10px 16px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.6);
    }

    .controller-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      font-size: 13px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #fff;
    }

    .controller-pill {
      background: #e5a93c;
      color: #143024;
      font-size: 10px;
      font-weight: 800;
      padding: 2px 7px;
      border-radius: 999px;
    }

    .theme-nav-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }

    .theme-btn {
      background: #181920;
      color: #8f96a3;
      border: 1px solid #282a36;
      padding: 6px 12px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 7px;
      transition: var(--transition-smooth);
    }

    .theme-btn:hover {
      color: #fff;
      border-color: #4a4d60;
      background: #22242e;
    }

    .theme-btn.active {
      color: #fff;
      border-color: #e5a93c;
      background: #252836;
      box-shadow: 0 0 12px rgba(229, 169, 60, 0.3);
    }

    .pair-quick-toggle {
      background: #1c2233 !important;
      border: 1px solid #e5a93c !important;
      color: #ffffff !important;
      box-shadow: 0 0 14px rgba(229, 169, 60, 0.25);
    }

    .pair-quick-toggle:hover {
      background: #273047 !important;
      box-shadow: 0 0 18px rgba(229, 169, 60, 0.4);
    }

    .theme-tag-light {
      background: #38bdf8;
      color: #031c29;
      font-size: 9px;
      font-weight: 800;
      padding: 1px 5px;
      border-radius: 4px;
      text-transform: uppercase;
      margin-left: 2px;
    }

    .theme-color-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      display: inline-block;
    }

    .view-mode-toggle {
      display: flex;
      background: #14151a;
      border: 1px solid #282a36;
      border-radius: 6px;
      padding: 3px;
    }

    .mode-btn {
      background: transparent;
      border: none;
      color: #888;
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 600;
      border-radius: 4px;
      cursor: pointer;
      transition: var(--transition-smooth);
    }

    .mode-btn.active {
      background: #2c2f3d;
      color: #fff;
    }

    /* ==========================================================================
       SITE CONTAINER & HEADER
       ========================================================================== */
    .site-wrapper {
      max-width: 1240px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .site-header {
      border-bottom: 1px solid var(--border-color);
      background: var(--bg-surface);
      position: sticky;
      top: 57px;
      z-index: 50;
      transition: var(--transition-smooth);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
    }

    .brand-logo-container {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-icon-toggle {
      width: 42px;
      height: 42px;
      border-radius: var(--btn-radius);
      background: var(--accent);
      color: var(--accent-text);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--btn-shadow);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, background-color 0.3s ease;
      cursor: pointer;
      border: 1px solid rgba(255, 255, 255, 0.15);
      position: relative;
      padding: 0;
      outline: none;
      user-select: none;
    }

    body[data-theme="theme-6"] .brand-icon-toggle {
      background: #143024;
      color: #e5a93c;
      border: 1.5px solid #e5a93c;
    }

    body[data-theme="theme-2"] .brand-icon-toggle {
      background: #e05a2b;
      color: #ffffff;
      border: 1.5px solid #e59b3c;
    }

    .brand-icon-toggle:hover {
      transform: scale(1.09);
    }

    .brand-icon-toggle:active {
      transform: scale(0.94);
    }

    .brand-icon-toggle::after {
      content: attr(data-tooltip);
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      white-space: nowrap;
      background: rgba(15, 23, 42, 0.95);
      color: #ffffff;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 11px;
      font-weight: 600;
      padding: 5px 10px;
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.15);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.6);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-4px);
      transition: opacity 0.2s ease, transform 0.2s ease;
      z-index: 70;
    }

    .brand-icon-toggle:hover::after {
      opacity: 1;
      transform: translateY(0);
    }

    .gripper-svg {
      width: 24px;
      height: 24px;
      overflow: visible;
      transition: transform 0.2s ease;
    }

    .gripper-coil {
      transform-origin: 50px 32px;
      transition: transform 0.25s ease;
    }

    .gripper-handle-left {
      transform-origin: 38px 36px;
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .gripper-handle-right {
      transform-origin: 62px 36px;
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .brand-icon-toggle.crushing .gripper-handle-left {
      transform: rotate(14deg);
    }

    .brand-icon-toggle.crushing .gripper-handle-right {
      transform: rotate(-14deg);
    }

    .brand-icon-toggle.crushing .gripper-coil {
      transform: scale(0.92);
    }

    .brand-text {
      display: flex;
      flex-direction: column;
    }

    .brand-title {
      font-family: var(--font-display);
      font-size: 20px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      line-height: 1.1;
      color: var(--text-main);
    }

    .brand-title span {
      color: var(--accent);
    }

    body[data-theme="theme-6"] .brand-title span {
      color: var(--accent-gold);
    }

    .brand-motto-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 2px;
    }

    .brand-motto {
      font-family: var(--font-accent);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--text-muted);
      font-weight: 700;
    }

    .mode-switch-pill {
      background: var(--bg-elevated);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      font-family: var(--font-accent);
      font-size: 9px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 1px 7px;
      border-radius: 999px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: var(--transition-smooth);
      outline: none;
    }

    .mode-switch-pill:hover {
      border-color: var(--accent);
      transform: scale(1.05);
    }

    body[data-theme="theme-6"] .mode-switch-pill {
      background: #143024;
      border-color: #e5a93c;
      color: #e5a93c;
    }

    body[data-theme="theme-2"] .mode-switch-pill {
      background: rgba(224, 90, 43, 0.18);
      border-color: #e05a2b;
      color: #e59b3c;
    }

    .site-nav {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .nav-link {
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
      padding: 6px 12px;
      border-radius: var(--btn-radius);
      transition: var(--transition-smooth);
    }

    .nav-link:hover {
      color: var(--text-main);
      background: var(--bg-elevated);
    }

    .nav-link.active {
      color: var(--accent);
      background: var(--badge-bg);
      border: 1px solid var(--badge-border);
    }

    body[data-theme="theme-6"] .nav-link.active {
      color: #ffffff;
      background: var(--accent);
      border: 1px solid var(--accent);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .search-btn {
      background: var(--bg-elevated);
      border: 1px solid var(--border-color);
      color: var(--text-muted);
      padding: 6px 12px;
      border-radius: var(--btn-radius);
      font-size: 12px;
      font-family: var(--font-accent);
      display: flex;
      align-items: center;
      gap: 6px;
      cursor: pointer;
      transition: var(--transition-smooth);
    }

    .search-btn:hover {
      color: var(--text-main);
      border-color: var(--accent);
    }

    /* ==========================================================================
       HERO VIDEO & ACTION BUTTONS
       ========================================================================== */
    .hero-media-wrapper {
      position: relative;
      width: 100%;
      height: 380px;
      background: #000;
      border-bottom: 1px solid var(--border-color);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-bg-poster {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.85) 100%),
                  radial-gradient(circle at 50% 50%, rgba(20,48,36,0.2) 0%, #050608 80%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-media-badge {
      position: absolute;
      bottom: 20px;
      right: 20px;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      border: 1px solid var(--border-color);
      color: #ffffff;
      font-family: var(--font-accent);
      font-size: 11px;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: var(--btn-radius);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .pulse-dot {
      width: 8px;
      height: 8px;
      background: var(--accent);
      border-radius: 50%;
      animation: pulse 1.5s infinite;
    }

    body[data-theme="theme-6"] .pulse-dot {
      background: var(--accent-gold);
    }

    @keyframes pulse {
      0% { opacity: 0.4; transform: scale(0.9); }
      50% { opacity: 1; transform: scale(1.1); }
      100% { opacity: 0.4; transform: scale(0.9); }
    }

    .hero-center-content {
      position: relative;
      z-index: 2;
      text-align: center;
      max-width: 700px;
      padding: 0 20px;
    }

    .hero-play-icon {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--accent);
      color: var(--accent-text);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      box-shadow: var(--btn-shadow);
      cursor: pointer;
      transition: var(--transition-smooth);
    }

    body[data-theme="theme-6"] .hero-play-icon {
      background: var(--accent-gold);
      color: #143024;
    }

    .hero-play-icon:hover {
      transform: scale(1.08);
    }

    .hero-action-strip {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border-color);
      padding: 30px 20px;
      transition: var(--transition-smooth);
    }

    .hero-action-grid {
      max-width: 640px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .btn-primary {
      background: var(--accent);
      color: var(--accent-text);
      font-family: var(--font-accent);
      font-size: 15px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 16px 22px;
      border-radius: var(--btn-radius);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      border: 1px solid transparent;
      box-shadow: var(--btn-shadow);
      cursor: pointer;
      transition: var(--transition-smooth);
      text-align: center;
    }

    body[data-theme="theme-6"] .btn-primary {
      background: #143024;
      color: #ffffff;
      border: 1px solid #143024;
    }

    .btn-primary:hover {
