<script>
  // -------------------------------------------------------------
  // CALCULATOR LOGIC
  // -------------------------------------------------------------
  const qtyInput = document.getElementById('gripper-count-input') as HTMLInputElement | null;
  const qtySlider = document.getElementById('gripper-count-slider') as HTMLInputElement | null;
  const btnDec = document.getElementById('btn-decrement');
  const btnInc = document.getElementById('btn-increment');
  const presetBtns = document.querySelectorAll('.preset-btn');
  const serviceFeeEl = document.getElementById('calc-service-fee');
  const breakdownEl = document.getElementById('calc-breakdown');
  const totalOutlayEl = document.getElementById('calc-total-outlay');
  const savingsEl = document.getElementById('calc-savings');
  const satchelEl = document.getElementById('satchel-recommendation');
  const syncBtn = document.getElementById('btn-sync-to-booking');
  const syncText = document.getElementById('btn-sync-text');

  // Form elements to sync
  const formQty = document.getElementById('form-qty') as HTMLInputElement | null;
  const formName = document.getElementById('form-name') as HTMLInputElement | null;
  const formEmail = document.getElementById('form-email') as HTMLInputElement | null;
  const formInsta = document.getElementById('form-instagram') as HTMLInputElement | null;
  const formLoc = document.getElementById('form-location') as HTMLInputElement | null;
  const formGrippers = document.getElementById('form-grippers-list') as HTMLInputElement | null;
  const formNotes = document.getElementById('form-notes') as HTMLTextAreaElement | null;
  const manifestEl = document.getElementById('manifest-preview');
  const bookingForm = document.getElementById('booking-form') as HTMLFormElement | null;
  const copyBtn = document.getElementById('btn-copy-manifest');
  const copyLabel = document.getElementById('copy-btn-label');
  const copyToast = document.getElementById('copy-toast');

  function calculateFee(qty: number) {
    if (qty <= 0) return 0;
    if (qty === 1) return 10;
    return 10 + (qty - 1) * 5;
  }

  function getSatchelInfo(qty: number) {
    if (qty <= 3) {
      return { name: "Australia Post Small Satchel (~$10.90 AUD)", cost: 10.90, desc: "Fits 1 to 3 wrapped grippers" };
    } else if (qty <= 7) {
      return { name: "Australia Post Medium Satchel (~$14.80 AUD)", cost: 14.80, desc: "Fits 4 to 7 wrapped grippers" };
    } else {
      return { name: "Australia Post Large Satchel (~$18.65 AUD)", cost: 18.65, desc: "Fits 8+ wrapped grippers" };
    }
  }

  function updateCalculator(qty: number) {
    const validQty = Math.max(1, Math.min(50, qty));
    if (qtyInput && parseInt(qtyInput.value) !== validQty) qtyInput.value = validQty.toString();
    if (qtySlider && parseInt(qtySlider.value) !== validQty) qtySlider.value = validQty.toString();
    if (formQty && parseInt(formQty.value) !== validQty) formQty.value = validQty.toString();

    const fee = calculateFee(validQty);
    const satchel = getSatchelInfo(validQty);
    const totalOutlay = fee + satchel.cost;

    // US Comparison estimate:
    // US Rating ($10 USD = ~$15 AUD 1st, $5 USD = ~$8 AUD extra) + Int'l postage ($70-$100 AUD roundtrip)
    const usEquivalentEst = (15 + (validQty - 1) * 8) + 85;
    const estSavings = Math.max(50, Math.round(usEquivalentEst - totalOutlay));

    if (serviceFeeEl) serviceFeeEl.textContent = `$${fee} AUD`;
    if (breakdownEl) {
      breakdownEl.textContent = validQty === 1
        ? "$10 for single gripper"
        : `$10 (1st) + $${(validQty - 1) * 5} (${validQty - 1} × $5)`;
    }
    if (totalOutlayEl) totalOutlayEl.textContent = `~$${Math.round(totalOutlay)} AUD`;
    if (savingsEl) savingsEl.textContent = `Saves ~$${estSavings}+ AUD vs US Shipping`;
    if (satchelEl) satchelEl.textContent = satchel.name;
    if (syncText) syncText.textContent = `Proceed with ${validQty} Gripper${validQty > 1 ? 's' : ''} to Booking Form →`;

    updateManifest();
  }

  qtyInput?.addEventListener('input', () => {
    const val = parseInt(qtyInput.value) || 1;
    updateCalculator(val);
  });

  qtySlider?.addEventListener('input', () => {
    const val = parseInt(qtySlider.value) || 1;
    updateCalculator(val);
  });

  btnDec?.addEventListener('click', () => {
    const current = parseInt(qtyInput?.value || '3');
    updateCalculator(current - 1);
  });

  btnInc?.addEventListener('click', () => {
    const current = parseInt(qtyInput?.value || '3');
    updateCalculator(current + 1);
  });

  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const q = parseInt(btn.getAttribute('data-qty') || '3');
      updateCalculator(q);
    });
  });

  // -------------------------------------------------------------
  // MANIFEST GENERATOR & FORM SYNC
  // -------------------------------------------------------------
  function generateManifestText() {
    const name = formName?.value.trim() || '[Your Name]';
    const email = formEmail?.value.trim() || '[Your Email]';
    const insta = formInsta?.value.trim() || 'N/A';
    const loc = formLoc?.value.trim() || 'Australia';
    const qty = parseInt(formQty?.value || qtyInput?.value || '3') || 3;
    const grippers = formGrippers?.value.trim() || '[e.g. CoC #1.5, CoC #2, GHP 6]';
    const notes = formNotes?.value.trim() || 'None';
    const fee = calculateFee(qty);
    const satchel = getSatchelInfo(qty);

    return `=== ARTIE'S GRIP GYM: RATING SERVICE REQUEST ===
Date: ${new Date().toLocaleDateString('en-AU')}
Name: ${name}
Email: ${email}
Instagram / Mobile: ${insta}
Return Location: ${loc}

--- SHIPMENT DETAILS ---
Quantity of Grippers: ${qty}
Grippers to Rate:
${grippers}

Return Postage Included: Yes (${satchel.name.split(' (')[0]})
Estimated Service Fee: $${fee} AUD (PayID / Bank Transfer)

Special Notes / Questions:
${notes}
===================================================`;
  }

  const emailMailtoBtn = document.getElementById('btn-email-mailto') as HTMLAnchorElement | null;

  function updateManifest() {
    if (manifestEl) {
      manifestEl.textContent = generateManifestText();
    }
    if (emailMailtoBtn) {
      const name = formName?.value.trim() || 'Athlete';
      const bodyText = generateManifestText();
      const subject = encodeURIComponent(`Gripper Rating Service Request: ${name}`);
      const body = encodeURIComponent(bodyText);
      emailMailtoBtn.href = `mailto:gripsportaustralia@gmail.com?subject=${subject}&body=${body}`;
    }
  }

  [formName, formEmail, formInsta, formLoc, formGrippers, formNotes].forEach(el => {
    el?.addEventListener('input', updateManifest);
  });

  formQty?.addEventListener('input', () => {
    const val = parseInt(formQty.value) || 1;
    updateCalculator(val);
  });

  // Submit via Mailto
  bookingForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = formName?.value.trim() || 'Athlete';
    const bodyText = generateManifestText();
    const subject = encodeURIComponent(`Gripper Rating Service Request: ${name}`);
    const body = encodeURIComponent(bodyText);
    const mailtoUrl = `mailto:gripsportaustralia@gmail.com?subject=${subject}&body=${body}`;
    window.location.href = mailtoUrl;
  });

  // Copy manifest to clipboard
  copyBtn?.addEventListener('click', async () => {
    const text = generateManifestText();
    try {
      await navigator.clipboard.writeText(text);
      if (copyLabel) copyLabel.textContent = "Copied to Clipboard!";
      if (copyToast) copyToast.classList.remove('hidden');
      setTimeout(() => {
        if (copyLabel) copyLabel.textContent = "Copy Manifest to Clipboard";
      }, 3000);
    } catch (err) {
      // Fallback
      if (manifestEl) {
        const range = document.createRange();
        range.selectNodeContents(manifestEl);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
        if (copyLabel) copyLabel.textContent = "Selected! Press Ctrl+C";
      }
    }
  });

  // -------------------------------------------------------------
  // FAQ ACCORDION LOGIC
  // -------------------------------------------------------------
  const faqToggles = document.querySelectorAll('.faq-toggle');
  faqToggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      const contentId = toggle.getAttribute('aria-controls');
      const content = contentId ? document.getElementById(contentId) : null;
      const icon = toggle.querySelector('.faq-icon');

      toggle.setAttribute('aria-expanded', (!isExpanded).toString());
      if (content) {
        content.classList.toggle('hidden');
      }
      if (icon) {
        icon.classList.toggle('rotate-180');
      }
    });
  });

  // Initialize
  updateCalculator(3);
</script>
