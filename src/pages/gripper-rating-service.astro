---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getUrl } from '../utils/url';
import imgAllGrippers from '../assets/images/gripper-rating-service-6c1d6506.jpg';
import imgDetailGrippers from '../assets/images/gripper-rating-service-8e9aa502.jpg';

const pageTitle = "Australian Gripper Rating Service — Artie's Grip Gym";
const pageDescription = "Accurate RGC calibration for torsion-spring hand grippers in Australia. Tested against Cannon PowerWorks standards with durable color-coded tags. Save on international shipping with fast local turnaround.";

// Standard RGC Reference Data for popular grippers
const rgcBenchmarks = [
  { name: 'CoC Guide', nominal: '60 lbs', avgRgc: '32 lbs', rgcKg: '14.5 kg', spread: 'Intermediate Warmup', tier: 'Warmup & Rehab', badgeColor: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20' },
  { name: 'CoC Sport', nominal: '80 lbs', avgRgc: '48 lbs', rgcKg: '21.8 kg', spread: 'Beginner Strength', tier: 'Beginner', badgeColor: 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20' },
  { name: 'CoC Trainer', nominal: '100 lbs', avgRgc: '58 lbs', rgcKg: '26.3 kg', spread: 'General Fitness Benchmark', tier: 'Beginner / Fitness', badgeColor: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20' },
  { name: 'CoC 0.5', nominal: '120 lbs', avgRgc: '71 lbs', rgcKg: '32.2 kg', spread: 'Bridge to Iron', tier: 'Intermediate Step', badgeColor: 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20' },
  { name: 'CoC #1', nominal: '140 lbs', avgRgc: '81 lbs', rgcKg: '36.7 kg', spread: 'Solid Crushing Foundation', tier: 'Solid Crushing', badgeColor: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20' },
  { name: 'CoC #1.5', nominal: '167.5 lbs', avgRgc: '92 lbs', rgcKg: '41.7 kg', spread: 'Crucial Stepping Stone', tier: 'Advanced Intermediate', badgeColor: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20' },
  { name: 'CoC #2', nominal: '195 lbs', avgRgc: '106 lbs', rgcKg: '48.1 kg', spread: 'Feat of Strength Milestone', tier: 'Advanced Milestone', badgeColor: 'bg-orange-500/10 text-orange-600 dark:text-orange-400 border-orange-500/20' },
  { name: 'GHP Level 6', nominal: '220 lbs', avgRgc: '118 lbs', rgcKg: '53.5 kg', spread: 'The Perfect Bridge to 2.5', tier: 'Gap Bridging', badgeColor: 'bg-orange-500/10 text-orange-600 dark:text-orange-400 border-orange-500/20' },
  { name: 'CoC #2.5', nominal: '237.5 lbs', avgRgc: '128 lbs', rgcKg: '58.1 kg', spread: 'The Grand Plateau', tier: 'Pre-Elite Crusher', badgeColor: 'bg-red-500/10 text-red-600 dark:text-red-400 border-red-500/20' },
  { name: 'GHP Level 7', nominal: '265 lbs', avgRgc: '138 lbs', rgcKg: '62.6 kg', spread: 'Final Gateway to CoC #3', tier: 'Gap Bridging', badgeColor: 'bg-red-500/10 text-red-600 dark:text-red-400 border-red-500/20' },
  { name: 'CoC #3', nominal: '280 lbs', avgRgc: '150 lbs', rgcKg: '68.0 kg', spread: 'World-Class Certification', tier: 'World-Class Certified', badgeColor: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20' },
  { name: 'CoC #3.5', nominal: '322.5 lbs', avgRgc: '175 lbs', rgcKg: '79.4 kg', spread: 'Rare Super-Heavy Feat', tier: 'Legendary Elite', badgeColor: 'bg-purple-500/10 text-purple-600 dark:text-purple-400 border-purple-500/20' },
  { name: 'CoC #4', nominal: '365 lbs', avgRgc: '210 lbs', rgcKg: '95.3 kg', spread: 'Pinnacle Human Limit', tier: 'Mythic Benchmark', badgeColor: 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border-rose-500/20' },
];

const faqs = [
  {
    q: "What is an RGC rating and how is it measured?",
    a: "RGC stands for Rating Gripper Calibration (originally developed by the grip community and standardized by Cannon PowerWorks). It is the universal standard for rating torsion-spring hand grippers. The gripper is clamped horizontally into a rigid steel fixture by one handle. A 1/4-inch calibration strap is positioned at the very tip of the free handle, and calibrated weight is suspended until the handles make full parallel contact. The total closing weight in pounds is the gripper's true RGC."
  },
  {
    q: "Why do manufacturer ratings differ so drastically from RGC?",
    a: "Manufacturer numbers (such as a Captains of Crush #2 advertised at '195 lbs') reflect either the theoretical spring torque, midpoint estimate, or nominal force before mechanical leverage is considered. When an athlete closes a gripper in real life, their hand exerts force along the entire length of the handle. RGC standardizes measurement at the tips, which accurately reflects real-world closing difficulty."
  },
  {
    q: "How does Artie's calibration compare to Cannon PowerWorks (USA)?",
    a: "Artie's Grip Gym has cross-calibrated their horizontal rating rig and scale measurements directly against Cannon PowerWorks benchmark grippers. This ensures Australian lifters receive 1:1 comparable ratings that match the global standard, without paying exorbitant US shipping, customs, or exchange rate fees."
  },
  {
    q: "What brands and types of hand grippers can be rated?",
    a: "Virtually all standard torsion-spring hand grippers can be rated! This includes Captains of Crush (IronMind), GHP (Gillingham High Performance), Heavy Grips, Robert Baraban, FBBC, Standard Grippers, Warren Tetting, Atomgripz, and Silver Bullet training grippers. Both standard and left-handed grippers are accepted."
  },
  {
    q: "Does rating damage or weaken the gripper spring?",
    a: "No. The horizontal static calibration applies a slow, smooth, controlled load equivalent to a single clean close under contest rules. It does not shock or over-deflect the spring beyond its designed closure point."
  },
  {
    q: "What kind of rating tag is attached to the gripper?",
    a: "Every gripper rated by Artie receives an anodized, color-coded aluminum disc tag securely looped around the spring coil. The tag is permanently stamped with the gripper's exact RGC value (e.g. 77, 85, 101, 121 lbs) for instant identification in your gym bag or warmup line."
  },
  {
    q: "How does return shipping work?",
    a: "You must include a self-addressed, pre-paid Australia Post tracked satchel (Small, Medium, or Large depending on your parcel weight) inside your shipping box. Once Artie finishes rating and tagging your grippers, they will be securely repacked and dispatched right back to you in your own satchel."
  },
  {
    q: "What is the typical turnaround time?",
    a: "Turnaround is fast — typically 2 to 4 business days from the moment your grippers arrive at Artie's workshop. You will be notified when they are tested and lodged back with Australia Post."
  },
  {
    q: "How do I make payment?",
    a: "Payment is arranged via PayID or direct Australian bank transfer upon confirmation of your booking request. Exact details are provided once you submit the inquiry form."
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Breadcrumbs -->
    <nav class="flex items-center space-x-2 text-xs text-[var(--text-muted)] mb-6 font-mono" aria-label="Breadcrumb">
      <a href={getUrl('/')} class="hover:text-[var(--accent-gold)] transition-colors">Home</a>
      <span>/</span>
      <span class="text-[var(--text-main)] truncate font-semibold">Gripper Rating Service</span>
    </nav>

    <!-- Header Section -->
    <header class="pb-8 mb-10 border-b border-[var(--border-color)]">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-[var(--accent-gold)]/15 text-[var(--accent-gold)] border border-[var(--accent-gold)]/30">
          Artie's Grip Gym
        </span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono text-[var(--text-muted)] bg-[var(--bg-elevated)] border border-[var(--border-color)]">
          Standardized RGC Calibration
        </span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono text-[var(--accent)] font-semibold bg-[var(--accent)]/10 border border-[var(--accent)]/20">
          Australian Service
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-[var(--text-main)] font-display uppercase tracking-tight leading-tight">
        Gripper <span class="text-[var(--accent-gold)]">Rating Service</span>
      </h1>

      <p class="mt-4 text-lg text-[var(--text-muted)] leading-relaxed max-w-3xl">
        Discover your grippers' true closing poundage with calibrated RGC testing right here in Australia. Matched directly to Cannon PowerWorks standards, backed by durable color-coded aluminum tags, and delivered at a fraction of international shipping costs.
      </p>

      <!-- Quick Fast Facts & CTA Bar -->
      <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)] shadow-sm">
          <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)]">1st Gripper</div>
          <div class="text-2xl sm:text-3xl font-black font-display text-[var(--accent-gold)] mt-1">$10 <span class="text-xs font-normal text-[var(--text-muted)]">AUD</span></div>
          <div class="text-[11px] text-[var(--text-subtle)] mt-0.5">Initial calibration fee</div>
        </div>

        <div class="p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)] shadow-sm">
          <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)]">Each Additional</div>
          <div class="text-2xl sm:text-3xl font-black font-display text-[var(--accent-gold)] mt-1">$5 <span class="text-xs font-normal text-[var(--text-muted)]">AUD</span></div>
          <div class="text-[11px] text-[var(--text-subtle)] mt-0.5">In same shipment</div>
        </div>

        <div class="p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)] shadow-sm">
          <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)]">Standard</div>
          <div class="text-2xl sm:text-3xl font-black font-display text-[var(--text-main)] mt-1">1:1 <span class="text-xs font-normal text-[var(--text-muted)]">Parity</span></div>
          <div class="text-[11px] text-[var(--text-subtle)] mt-0.5">Cannon PowerWorks RGC</div>
        </div>

        <div class="p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)] shadow-sm">
          <div class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)]">Turnaround</div>
          <div class="text-2xl sm:text-3xl font-black font-display text-[var(--text-main)] mt-1">2–4 <span class="text-xs font-normal text-[var(--text-muted)]">Days</span></div>
          <div class="text-[11px] text-[var(--text-subtle)] mt-0.5">Fast local Aus dispatch</div>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="#calculator"
          class="px-5 py-2.5 rounded-[var(--btn-radius)] bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-text)] font-bold text-sm shadow-md transition-all font-accent uppercase tracking-wider flex items-center gap-2"
        >
          <svg class="w-4 h-4 text-[var(--accent-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
          </svg>
          <span>Calculate Pricing</span>
        </a>

        <a
          href="#booking"
          class="px-5 py-2.5 rounded-[var(--btn-radius)] bg-[var(--bg-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-main)] border border-[var(--border-color)] font-semibold text-sm transition-all shadow-sm font-accent uppercase tracking-wider flex items-center gap-2"
        >
          <svg class="w-4 h-4 text-[var(--accent-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span>Book Rating / Inquiry</span>
        </a>

        <a
          href="#benchmarks"
          class="px-5 py-2.5 rounded-[var(--btn-radius)] bg-[var(--bg-surface)] hover:bg-[var(--bg-elevated)] text-[var(--accent-gold)] border border-[var(--accent-gold)]/40 font-semibold text-sm transition-all shadow-sm font-accent uppercase tracking-wider flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          <span>RGC Benchmark Chart</span>
        </a>
      </div>
    </header>

    <!-- Visual Showcase / Tagged Grippers Gallery -->
    <section class="mb-14">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
        
        <div class="group bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-2xl overflow-hidden shadow-sm flex flex-col">
          <div class="relative overflow-hidden bg-black/5 aspect-4/3 flex items-center justify-center">
            <Image
              src={imgAllGrippers}
              alt="Hand grippers arrayed with color-coded RGC rating tags: 62, 77, 81, 85, 101, 121 lbs"
              class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-300"
            />
            <span class="absolute bottom-3 left-3 bg-black/75 backdrop-blur-md text-white px-3 py-1 rounded-md text-xs font-mono">
              Calibrated Array with RGC Tags
            </span>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-display font-bold text-lg uppercase text-[var(--text-main)] tracking-wide">
                Calibrated Tagging System
              </h3>
              <p class="text-xs text-[var(--text-muted)] mt-1.5 leading-relaxed">
                Every rated gripper is outfitted with an anodized aluminum disc tag permanently stamped with its certified RGC poundage. Color coding allows immediate identification during intense training blocks.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-[var(--border-color)] flex items-center gap-2 text-[11px] font-mono text-[var(--accent-gold)]">
              <span class="w-2 h-2 rounded-full bg-[var(--accent-gold)] animate-pulse"></span>
              Tagged RGC values: 62, 77, 81, 85, 101, 121 lbs shown above
            </div>
          </div>
        </div>

        <div class="group bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-2xl overflow-hidden shadow-sm flex flex-col">
          <div class="relative overflow-hidden bg-black/5 aspect-4/3 flex items-center justify-center">
            <Image
              src={imgDetailGrippers}
              alt="Detail close-up of knurled gripper handles and durable rating tags"
              class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-300"
            />
            <span class="absolute bottom-3 left-3 bg-black/75 backdrop-blur-md text-white px-3 py-1 rounded-md text-xs font-mono">
              Precision Knurling & Spring Mounting
            </span>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-display font-bold text-lg uppercase text-[var(--text-main)] tracking-wide">
                Precision Rig Testing
              </h3>
              <p class="text-xs text-[var(--text-muted)] mt-1.5 leading-relaxed">
                Tested horizontally under strict mechanical criteria. The test isolates pure spring resistance from handle friction, giving you an exact metric you can trust for competition preparation and plateau busting.
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-[var(--border-color)] flex items-center gap-2 text-[11px] font-mono text-[var(--text-muted)]">
              <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Standardized 1/4" handle bevel calibration point
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Deep Dive: What is RGC and Why Rate Your Grippers? -->
    <section class="mb-14 p-6 sm:p-8 rounded-2xl bg-[var(--bg-elevated)] border border-[var(--border-color)]">
      <div class="max-w-3xl mb-6">
        <h2 class="text-xs font-bold text-[var(--accent-gold)] tracking-widest uppercase mb-1 font-accent">The Science of Calibration</h2>
        <p class="text-2xl sm:text-3xl font-black text-[var(--text-main)] font-display uppercase">Why Rate Your Grippers?</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="bg-[var(--bg-surface)] p-5 rounded-xl border border-[var(--border-color)]">
          <div class="w-10 h-10 rounded-lg bg-[var(--accent)]/10 text-[var(--accent)] flex items-center justify-center mb-3 font-mono font-bold text-base">
            01
          </div>
          <h3 class="font-display font-bold text-base uppercase text-[var(--text-main)] mb-2">
            Manufacturer Tolerances Vary Wildly
          </h3>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">
            Spring winding tension, wire diameter variance, and handle mounting depths mean two grippers stamped with the exact same model number (e.g. CoC #2) can differ by <strong>10 to 15+ lbs RGC</strong>. A "hard" #2 can be harder than an "easy" #2.5! Rating eliminates the guesswork.
          </p>
        </div>

        <div class="bg-[var(--bg-surface)] p-5 rounded-xl border border-[var(--border-color)]">
          <div class="w-10 h-10 rounded-lg bg-[var(--accent-gold)]/15 text-[var(--accent-gold)] flex items-center justify-center mb-3 font-mono font-bold text-base">
            02
          </div>
          <h3 class="font-display font-bold text-base uppercase text-[var(--text-main)] mb-2">
            Bridge the Brutal Plateau Chasms
          </h3>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">
            The gap between a Captains of Crush #2 (avg ~106 lbs) and a #2.5 (avg ~128 lbs) is over <strong>20 lbs of pure crushing force</strong>. Rating your collection lets you find intermediate stepping stones (like a 115 lb GHP 6 or 121 lb Heavy Grip) to progress without stalled momentum or injury.
          </p>
        </div>

        <div class="bg-[var(--bg-surface)] p-5 rounded-xl border border-[var(--border-color)]">
          <div class="w-10 h-10 rounded-lg bg-[var(--accent)]/10 text-[var(--accent)] flex items-center justify-center mb-3 font-mono font-bold text-base">
            03
          </div>
          <h3 class="font-display font-bold text-base uppercase text-[var(--text-main)] mb-2">
            Genuine Standardized Progress Tracking
          </h3>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed">
            When you close a gripper in training, knowing its certified RGC lets you celebrate verifiable progress. You can calculate volume, peak intensity, and rate of perceived exertion (RPE) with mathematical precision just like a barbell deadlift.
          </p>
        </div>

      </div>

      <!-- Australia vs US Cost Comparison Callout -->
      <div class="mt-8 p-5 rounded-xl bg-[var(--bg-surface)] border border-[var(--accent-gold)]/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <span class="font-bold text-sm text-[var(--text-main)] font-display uppercase tracking-wider">
              Save $70 – $100+ AUD Over US Rating Services
            </span>
          </div>
          <p class="text-xs text-[var(--text-muted)] max-w-2xl">
            Cannon PowerWorks is the gold-standard US pioneer, but return international courier shipping and currency conversion to the USA can easily exceed $100+ AUD for just a few grippers. Artie's Grip Gym provides 1:1 calibrated equivalence with local Australian postage rates and instant domestic dispatch.
          </p>
        </div>

        <a
          href="#calculator"
          class="shrink-0 px-4 py-2 rounded-lg bg-[var(--accent-gold)] text-[var(--badge-text)] font-bold text-xs uppercase tracking-wider font-accent shadow-sm hover:opacity-90 transition-opacity"
        >
          Check Your Savings
        </a>
      </div>
    </section>

    <!-- Interactive Price & Shipping Calculator -->
    <section id="calculator" class="mb-14 scroll-mt-20">
      <div class="bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-2xl p-6 sm:p-8 shadow-sm">
        
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 pb-6 border-b border-[var(--border-color)]">
          <div>
            <h2 class="text-xs font-bold text-[var(--accent-gold)] tracking-widest uppercase mb-1 font-accent">Transparent Cost Calculator</h2>
            <p class="text-2xl sm:text-3xl font-black text-[var(--text-main)] font-display uppercase">Rating & Postage Estimator</p>
            <p class="text-xs text-[var(--text-muted)] mt-1">Rates: $10 for 1st gripper &bull; $5 each additional gripper in the same parcel</p>
          </div>

          <div class="mt-4 md:mt-0 flex items-center gap-2">
            <span class="text-xs text-[var(--text-muted)] font-mono">Quick select:</span>
            <button type="button" class="preset-btn px-2.5 py-1 rounded bg-[var(--bg-elevated)] hover:bg-[var(--accent-gold)]/20 text-xs font-mono font-bold text-[var(--text-main)] border border-[var(--border-color)] transition-colors" data-qty="1">1</button>
            <button type="button" class="preset-btn px-2.5 py-1 rounded bg-[var(--bg-elevated)] hover:bg-[var(--accent-gold)]/20 text-xs font-mono font-bold text-[var(--text-main)] border border-[var(--border-color)] transition-colors" data-qty="3">3</button>
            <button type="button" class="preset-btn px-2.5 py-1 rounded bg-[var(--bg-elevated)] hover:bg-[var(--accent-gold)]/20 text-xs font-mono font-bold text-[var(--text-main)] border border-[var(--border-color)] transition-colors" data-qty="5">5</button>
            <button type="button" class="preset-btn px-2.5 py-1 rounded bg-[var(--bg-elevated)] hover:bg-[var(--accent-gold)]/20 text-xs font-mono font-bold text-[var(--text-main)] border border-[var(--border-color)] transition-colors" data-qty="10">10</button>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          
          <!-- Input Controls -->
          <div class="lg:col-span-5 space-y-6">
            <div>
              <label for="gripper-count-input" class="block text-xs font-bold font-mono uppercase tracking-wider text-[var(--text-main)] mb-2">
                Number of Grippers to Rate
              </label>
              
              <div class="flex items-center space-x-3">
                <button
                  type="button"
                  id="btn-decrement"
                  class="w-12 h-12 rounded-xl bg-[var(--bg-elevated)] hover:bg-[var(--border-color)] border border-[var(--border-color)] text-[var(--text-main)] font-black text-xl flex items-center justify-center transition-all cursor-pointer select-none active:scale-95"
                  aria-label="Decrease quantity"
                >
                  &minus;
                </button>

                <input
                  type="number"
                  id="gripper-count-input"
                  min="1"
                  max="30"
                  value="3"
                  class="w-24 h-12 text-center text-2xl font-black font-display rounded-xl bg-[var(--bg-base)] border border-[var(--border-color)] text-[var(--text-main)] focus:outline-none focus:ring-2 focus:ring-[var(--accent-gold)]"
                />

                <button
                  type="button"
                  id="btn-increment"
