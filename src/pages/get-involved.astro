---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getUrl } from '../utils/url';
import communityPhoto from '../assets/images/get-involved-f7184e17.jpg';
import trainingPhoto from '../assets/images/get-involved-f3de02c0.jpg';

const pageTitle = "Get Involved in Australian Grip Sport: Community, Gyms & Events";
const pageDescription = "Your self-serve launchpad to Australian grip sport. Connect with local athletes on Instagram, find gyms and starter gear, join your first competition, or host a sanctioned meet.";

// State Directory Data
const states = [
  {
    state: "VIC",
    stateName: "Victoria",
    metro: "Melbourne & Regional",
    description: "Home to the 2026 Australian Championships and a dense concentration of competitive grip athletes and calibrated gripper rating.",
    anchors: [
      {
        name: "Iron Revolution Gym",
        location: "Melbourne (Coburg)",
        focus: "Host venue for the 2026 Australian Grip Sport Championship; dedicated strongman and grip sport implements including Saxon bars, Napalm's Nightmares, and calibrated plates.",
        tag: "Championship Host Gym"
      },
      {
        name: "Artie's Grip Gym & Calibration",
        location: "Melbourne",
        focus: "The national hub for RGC gripper rating and testing; active lifters testing crush and pinch implements.",
        link: getUrl('/gripper-rating-service'),
        linkText: "View Rating Service",
        tag: "RGC Calibration Hub"
      }
    ]
  },
  {
    state: "NSW",
    stateName: "New South Wales",
    metro: "Sydney & Newcastle",
    description: "Birthplace of the inaugural 2024 Australian Nationals and home to custom grip implement design and regular training syndicates.",
    anchors: [
      {
        name: "Club Strong Sydney",
        location: "Sydney Metro",
        focus: "Specialized grip and climbing strength implement designers, pinch blocks, and open-hand training gear.",
        externalLink: "https://clubstrong.com.au",
        linkText: "Visit Club Strong",
        tag: "Implement Designer & Gym"
      },
      {
        name: "Sydney Grip Athletes Syndicate",
        location: "Sydney Metro & Surrounds",
        focus: "Regular training groups and meet competitors practicing classic GSI disciplines and Inch dumbbell odd-object lifting.",
        tag: "Competitor Syndicate"
      }
    ]
  },
  {
    state: "QLD",
    stateName: "Queensland",
    metro: "Brisbane & Gold Coast",
    description: "Host of the historic 2025 Australian Nationals with an active community spanning strongman, armlifting, and specialised grip feats.",
    anchors: [
      {
        name: "Steel Stone Gym",
        location: "Brisbane (Northgate)",
        focus: "Host venue of the 2025 Australian Grip Sport Championship; equipped with contest-grade loading pins, rolling handles, and heavy plates.",
        tag: "Championship Host Gym"
      },
      {
        name: "Gold Coast / Sunshine Coast Grip Lifters",
        location: "South East Queensland",
        focus: "Regional lifters training thick-bar deadlifts, pinch blocks, and preparing for national events.",
        tag: "Regional Training"
      }
    ]
  },
  {
    state: "ACT",
    stateName: "Australian Capital Territory",
    metro: "Canberra",
    description: "Active competition hub hosting the annual StrongFest IV Grip Challenge and state record-setting meets.",
    anchors: [
      {
        name: "StrongFest Canberra & GSI Challenge",
        location: "Canberra",
        focus: "Regular GSI-sanctioned events including StrongFest IV and local record meets; excellent entry point for first-time competitors in the capital region.",
        link: getUrl('/competition-calendar'),
        linkText: "Check Calendar",
        tag: "Sanctioned Contest Venue"
      },
      {
        name: "Ultra Fitness & Strength",
        location: "Canberra (Mitchell)",
        focus: "Supporting venue for grip training with extensive specialised handles and implements including Napalm Nightmare and IronMind gear.",
        tag: "Grip Training Venue"
      }
    ]
  },
  {
    state: "TAS",
    stateName: "Tasmania",
    metro: "Hobart & State-wide",
    description: "Passionate strength community combining grip sport, Highland games, and the annual Hobart Hoist.",
    anchors: [
      {
        name: "Hobart Hoist Community",
        location: "Hobart",
        focus: "Organisers of the Hobart Hoist; welcomes newcomers, heavy stone lifters, and grip specialists from across Tasmania.",
        link: getUrl('/competition-calendar'),
        linkText: "View Hobart Hoist",
        tag: "Annual Event Hub"
      },
      {
        name: "Betapark",
        location: "Hobart",
        focus: "Climbing gym offering a dedicated grip training setup with IronMind grippers, Grip Genie handles, and pinch blocks.",
        tag: "Grip Training Setup"
      },
      {
        name: "Leviathan Strength",
        location: "Invermay (Launceston)",
        focus: "Strongman and strength athletics gym equipped with thick bars, axles, and diverse grip implements.",
        tag: "Strength Athletics Gym"
      }
    ]
  },
  {
    state: "WA-SA",
    stateName: "WA & SA",
    metro: "Perth & Adelaide",
    description: "Connected lifters training in private facilities, home gym syndicates, and competing in online postal contests.",
    anchors: [
      {
        name: "Western Australia & South Australia Network",
        location: "Perth & Adelaide",
        focus: "Lifters collaborating via Instagram and online scoreboards; competing in postal challenges and national qualifiers.",
        tag: "Postal & Home Gyms"
      }
    ]
  }
];

// Beginner First Comp FAQs
const firstCompFaqs = [
  {
    q: "Do I need to be an elite lifter to enter a competition?",
    a: "Absolutely not. Grip competitions cater to all strength levels from raw beginners testing their baseline to record chasers. Meets feature standard bodyweight divisions and novice categories."
  },
  {
    q: "What equipment do I need to bring on the day?",
    a: "Only your gym clothes and flat shoes (or deadlift slippers). All competition implements, loading pins, calibrated weights, and dry magnesium carbonate chalk are provided by the event host."
  },
  {
    q: "How does the contest format work?",
    a: "Most Australian meets use a 'rising bar' format. The weight on the implement increases in set increments. You choose which weights to attempt, and you are never forced to lift a weight beyond your current ability."
  },
  {
    q: "How are rules and referee commands handled?",
    a: "Every meet starts with a mandatory athlete rules briefing where the head referee physically demonstrates legal lockouts, legal hand placement, and the critical 'DOWN' signal. Questions are actively encouraged before lifting commences."
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-[var(--text-muted)] mb-6 font-mono" aria-label="Breadcrumb">
      <a href={getUrl('/')} class="hover:text-[var(--accent-gold)] transition-colors">Home</a>
      <span>/</span>
      <span class="text-[var(--text-main)] truncate font-semibold">Get Involved</span>
    </nav>

    <!-- Hero Section with Community Banner -->
    <header class="relative rounded-3xl overflow-hidden border border-[var(--border-color)] bg-[var(--bg-surface)] mb-14 shadow-lg">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
        
        <!-- Left: Copy & Pathways Overview -->
        <div class="lg:col-span-7 p-6 sm:p-10 flex flex-col justify-between">
          <div>
            <div class="flex flex-wrap items-center gap-2 mb-4">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-[var(--accent)] text-[var(--accent-text)] border border-[var(--accent-gold)]/40">
                Self-Serve Launchpad
              </span>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono text-[var(--text-muted)] bg-[var(--bg-elevated)] border border-[var(--border-color)]">
                Australian Grip Community
              </span>
            </div>

            <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-[var(--text-main)] font-display uppercase tracking-tight leading-tight">
              Get Involved in <span class="text-[var(--accent-gold)]">Australian Grip Sport</span>
            </h1>

            <p class="mt-4 text-base sm:text-lg text-[var(--text-muted)] leading-relaxed">
              Whether you want to crush your first heavy gripper, train with seasoned lifters, or step onto the platform at your first contest, this is your direct launchpad. No forms or gatekeeping—choose your pathway below.
            </p>
          </div>

          <!-- Quick Jump Buttons (3 Pathways + Meet Hosting) -->
          <div class="mt-10 pt-8 border-t border-[var(--border-color)]">
            <div class="flex flex-wrap items-center gap-3">
              <a
                href="#pathway-connect"
                class="px-4 py-2.5 rounded-[var(--btn-radius)] bg-[var(--bg-elevated)] hover:bg-[var(--accent)] hover:text-[var(--accent-text)] text-[var(--text-main)] border border-[var(--border-color)] font-accent uppercase text-xs tracking-wider font-bold transition-all flex items-center gap-2 shadow-sm hover:shadow"
              >
                <span class="text-[var(--accent-gold)] font-mono font-bold">1.</span>
                <span>Connect</span>
                <span class="text-xs">&darr;</span>
              </a>
              <a
                href="#pathway-train"
                class="px-4 py-2.5 rounded-[var(--btn-radius)] bg-[var(--bg-elevated)] hover:bg-[var(--accent)] hover:text-[var(--accent-text)] text-[var(--text-main)] border border-[var(--border-color)] font-accent uppercase text-xs tracking-wider font-bold transition-all flex items-center gap-2 shadow-sm hover:shadow"
              >
                <span class="text-[var(--accent-gold)] font-mono font-bold">2.</span>
                <span>Train</span>
                <span class="text-xs">&darr;</span>
              </a>
              <a
                href="#pathway-compete"
                class="px-4 py-2.5 rounded-[var(--btn-radius)] bg-[var(--bg-elevated)] hover:bg-[var(--accent)] hover:text-[var(--accent-text)] text-[var(--text-main)] border border-[var(--border-color)] font-accent uppercase text-xs tracking-wider font-bold transition-all flex items-center gap-2 shadow-sm hover:shadow"
              >
                <span class="text-[var(--accent-gold)] font-mono font-bold">3.</span>
                <span>Compete</span>
                <span class="text-xs">&darr;</span>
              </a>
              <a
                href="#host-a-meet"
                class="px-4 py-2.5 rounded-[var(--btn-radius)] bg-[var(--accent-gold)]/15 text-[var(--accent-gold)] hover:bg-[var(--accent-gold)]/25 border border-[var(--accent-gold)]/40 font-accent uppercase text-xs tracking-wider font-bold transition-all flex items-center gap-2 shadow-sm hover:shadow"
              >
                <span>Host a Meet</span>
                <span class="text-xs">&rarr;</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Community Photo Visual -->
        <div class="lg:col-span-5 relative min-h-[280px] lg:min-h-full border-t lg:border-t-0 lg:border-l border-[var(--border-color)] bg-black/20 overflow-hidden flex flex-col justify-end">
          <Image
            src={communityPhoto}
            alt="Australian grip sport athletes and competitors posing with calibrated plates and implements at a national meet."
            class="w-full h-full object-cover object-center transform hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent pointer-events-none"></div>
          <div class="absolute bottom-4 left-4 right-4 z-10">
            <div
              class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl backdrop-blur-md shadow-2xl border border-[var(--accent-gold)]/50"
              style="background-color: rgba(10, 10, 10, 0.88) !important; color: #ffffff !important;"
            >
              <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent-gold)] shrink-0 shadow-sm animate-pulse"></span>
              <span class="text-xs sm:text-sm font-mono font-bold tracking-wide" style="color: #ffffff !important;">
                Australian Grip Athletes &bull; National Community
              </span>
            </div>
          </div>
        </div>

      </div>
    </header>

    <!-- 3 Pathways Interactive Roadmap Grid -->
    <section class="mb-16">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- Pathway Card 1: Connect -->
        <a
          href="#pathway-connect"
          class="group p-6 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] transition-all shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-9 h-9 rounded-xl bg-[var(--accent-gold)]/15 text-[var(--accent-gold)] flex items-center justify-center font-mono font-bold text-sm border border-[var(--accent-gold)]/30">
                01
              </span>
              <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-subtle)] font-semibold">
                Socials & Clubs
              </span>
            </div>
            <h2 class="text-xl font-black font-display uppercase tracking-wide text-[var(--text-main)] group-hover:text-[var(--accent-gold)] transition-colors">
              Connect
            </h2>
            <p class="text-xs text-[var(--text-muted)] mt-2 leading-relaxed">
              Find training partners, message local lifters, join discussion boards, and discover regional clubs across every Australian state.
            </p>
          </div>
          <div class="mt-5 pt-3 border-t border-[var(--border-color)] flex items-center justify-between text-xs font-mono font-bold text-[var(--accent-gold)]">
            <span>Explore Community</span>
            <span class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Pathway Card 2: Train -->
        <a
          href="#pathway-train"
          class="group p-6 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] transition-all shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center font-mono font-bold text-sm border border-emerald-500/20">
                02
              </span>
              <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-subtle)] font-semibold">
                Gyms & Gear
              </span>
            </div>
            <h2 class="text-xl font-black font-display uppercase tracking-wide text-[var(--text-main)] group-hover:text-emerald-500 transition-colors">
              Train
            </h2>
            <p class="text-xs text-[var(--text-muted)] mt-2 leading-relaxed">
              Build your starter gym setup without breaking the bank, locate grip-friendly facilities, and calibrate your torsion-spring grippers.
            </p>
          </div>
          <div class="mt-5 pt-3 border-t border-[var(--border-color)] flex items-center justify-between text-xs font-mono font-bold text-emerald-500">
            <span>Gear & Facilities</span>
            <span class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

        <!-- Pathway Card 3: Compete -->
        <a
          href="#pathway-compete"
          class="group p-6 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] transition-all shadow-sm flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="w-9 h-9 rounded-xl bg-orange-500/10 text-orange-500 flex items-center justify-center font-mono font-bold text-sm border border-orange-500/20">
                03
              </span>
              <span class="text-[10px] font-mono uppercase tracking-wider text-[var(--text-subtle)] font-semibold">
                Meets & Sanctioning
              </span>
            </div>
            <h2 class="text-xl font-black font-display uppercase tracking-wide text-[var(--text-main)] group-hover:text-orange-500 transition-colors">
              Compete
            </h2>
            <p class="text-xs text-[var(--text-muted)] mt-2 leading-relaxed">
              Step onto the platform at a novice-friendly meet, view the national event calendar, or host your own sanctioned competition.
            </p>
          </div>
          <div class="mt-5 pt-3 border-t border-[var(--border-color)] flex items-center justify-between text-xs font-mono font-bold text-orange-500">
            <span>Find Competitions</span>
            <span class="transform group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>

      </div>
    </section>

    <!-- PATHWAY 1: CONNECT -->
    <section id="pathway-connect" class="mb-20 pt-8 border-t border-[var(--border-color)] scroll-mt-20">
      
      <div class="mb-8">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 rounded-full bg-[var(--accent-gold)]"></span>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--accent-gold)]">Pathway 01</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-[var(--text-main)] font-display uppercase tracking-tight">
          Connect with the <span class="text-[var(--accent-gold)]">Australian Community</span>
        </h2>
        <p class="mt-2 text-sm text-[var(--text-muted)] max-w-2xl leading-relaxed">
          Grip sport thrives on peer support, garage sessions, and shared technique tips. You don't have to train in isolation—here is how to link up with active lifters.
        </p>
      </div>

      <!-- Instagram & Direct Socials Feature Block -->
      <div class="p-6 sm:p-8 rounded-2xl bg-gradient-to-br from-[var(--bg-surface)] via-[var(--bg-surface)] to-[var(--bg-elevated)] border border-[var(--border-color)] mb-8 shadow-sm">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="space-y-3 max-w-2xl">
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-pink-500/10 text-pink-600 dark:text-pink-400 border border-pink-500/20">
                Official Social Hub
              </span>
              <span class="text-xs font-mono text-[var(--text-muted)]">Direct Lifter Network</span>
            </div>

            <h3 class="text-2xl font-black font-display uppercase tracking-wide text-[var(--text-main)]">
              Follow, Tag & DM: <a href="https://instagram.com/pinch_bypinch" target="_blank" rel="noopener noreferrer" class="text-[var(--accent-gold)] hover:underline">@pinch_bypinch</a>
            </h3>

            <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">
              Instagram is the primary daily communication channel for Australian grip lifters. If you're looking for training partners in your area, tag us in your training videos or send a direct message. We regularly spotlight local PRs, announce pop-up gym sessions, and connect newcomers with nearby veterans.
            </p>

            <!-- Community Hashtags -->
            <div class="pt-2 flex flex-wrap items-center gap-2 text-xs font-mono">
              <span class="text-[var(--text-subtle)]">Community Tags:</span>
              <a href="https://www.instagram.com/explore/tags/australiangripsport/" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-[var(--bg-base)] text-[var(--accent-gold)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] transition-colors">
                #AustralianGripSport
              </a>
              <a href="https://www.instagram.com/explore/tags/gripaustralia/" target="_blank" rel="noopener noreferrer" class="px-2 py-0.5 rounded bg-[var(--bg-base)] text-[var(--accent-gold)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] transition-colors">
                #GripAustralia
              </a>
            </div>
          </div>

          <!-- Direct Instagram Action Button -->
          <div class="shrink-0 w-full md:w-auto">
            <a
              href="https://instagram.com/pinch_bypinch"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full md:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-pink-600 via-rose-600 to-amber-600 hover:from-pink-500 hover:to-amber-500 text-white font-bold text-xs uppercase tracking-wider font-accent shadow-md transition-all transform hover:-translate-y-0.5"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>Connect on Instagram</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Forums & Online Discussion Hubs -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        
        <!-- GripBoard -->
        <div class="p-6 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)]/60 transition-all flex flex-col justify-between shadow-sm">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-mono uppercase font-bold px-2 py-0.5 rounded bg-[var(--accent-gold)]/15 text-[var(--accent-gold)] border border-[var(--accent-gold)]/30">
                Global Archive
              </span>
              <span class="text-xs font-mono text-[var(--text-muted)]">gripboard.com</span>
            </div>
            <h3 class="text-xl font-bold font-display uppercase text-[var(--text-main)]">
              The GripBoard
            </h3>
            <p class="text-xs text-[var(--text-muted)] mt-2 leading-relaxed">
              Founded by Bill Piche, The GripBoard is the world's most extensive repository of grip history, competitor training logs, implement dimensions, and feat certifications. If you have an odd equipment question or want to log your progress, this is the global authority.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-[var(--border-color)]">
            <a
              href="https://www.gripboard.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-mono font-bold text-[var(--accent-gold)] hover:underline inline-flex items-center gap-1.5"
            >
              <span>Visit The GripBoard Forum</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- r/GripTraining -->
        <div class="p-6 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)]/60 transition-all flex flex-col justify-between shadow-sm">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-mono uppercase font-bold px-2 py-0.5 rounded bg-orange-500/15 text-orange-600 dark:text-orange-400 border border-orange-500/30">
                Beginner Hub
              </span>
              <span class="text-xs font-mono text-[var(--text-muted)]">reddit.com/r/GripTraining</span>
            </div>
