<script>
  // State Directory Filtering
  const stateTabBtns = document.querySelectorAll('.state-tab-btn');
  const stateCards = document.querySelectorAll('.state-card') as NodeListOf<HTMLElement>;

  stateTabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      stateTabBtns.forEach(b => {
        b.classList.remove('active', 'bg-[var(--accent)]', 'text-[var(--accent-text)]', 'border-[var(--accent-gold)]/40');
        b.classList.add('bg-[var(--bg-elevated)]', 'text-[var(--text-muted)]');
      });

      btn.classList.add('active', 'bg-[var(--accent)]', 'text-[var(--accent-text)]', 'border-[var(--accent-gold)]/40');
      btn.classList.remove('bg-[var(--bg-elevated)]', 'text-[var(--text-muted)]');

      const selectedState = btn.getAttribute('data-state');

      stateCards.forEach((card) => {
        if (selectedState === 'all' || card.getAttribute('data-state') === selectedState) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Accordion Logic
  const accordionTriggers = document.querySelectorAll('.accordion-trigger');

  accordionTriggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
      const content = trigger.nextElementSibling as HTMLElement | null;
      const chevron = trigger.querySelector('.accordion-chevron') as HTMLElement | null;

      if (isExpanded) {
        trigger.setAttribute('aria-expanded', 'false');
        content?.classList.add('hidden');
        chevron?.classList.remove('rotate-180');
      } else {
        trigger.setAttribute('aria-expanded', 'true');
        content?.classList.remove('hidden');
        chevron?.classList.add('rotate-180');
      }
    });
  });

  // Copy Meet Host Template to Clipboard
  const copyBtn = document.getElementById('copy-template-btn');
  const copyLabel = document.getElementById('copy-btn-label');

  const meetTemplate = `EVENT NAME: [e.g. Melbourne Open Grip Challenge]
DATE & TIME: [e.g. Saturday, 15 November 2026, 10am]
VENUE / GYM: [Gym Name, Street Address, City, State]
PROMOTER / CONTACT: [Name & Instagram Handle]
ENTRY FEE: [e.g. $40]
REGISTRATION LINK: [Eventbrite / URL / DM to Enter]
EVENTS / DISCIPLINES:
1. 2.375" Rolling Handle (Napalm's Nightmare / Rolling Thunder)
2. 2-Hand Pinch (3" Euro Pinch / Flask)
3. IronMind Hub Lift
4. Axle Deadlift (Double Overhand)`;

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(meetTemplate);
      if (copyLabel) {
        copyLabel.textContent = "✓ Template Copied!";
        setTimeout(() => {
          copyLabel.textContent = "Copy Meet Template";
        }, 3000);
      }
    } catch (err) {
      if (copyLabel) {
        copyLabel.textContent = "Copy failed (browser denied)";
      }
    }
  });
</script>
