---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUrl } from '../utils/url';
import resultsData from '../data/results.json';

const pageTitle = "Australian Grip Sport Championships: National Archive & Honour Roll";
const pageDescription = "Explore the complete history of the Australian Grip Sport Championships (2024–2026). Official champions, pound-for-pound winners, event benchmarks, scoresheets, and venue archives.";

const years = [2026, 2025, 2024];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-[var(--text-muted)] mb-6 font-mono" aria-label="Breadcrumb">
      <a href={getUrl('/')} class="hover:text-[var(--accent-gold)] transition-colors">Home</a>
      <span>/</span>
      <span class="text-[var(--text-main)] truncate font-semibold">Championships Archive</span>
    </nav>

    <!-- Header Section -->
    <header class="pb-8 mb-10 border-b border-[var(--border-color)]">
      <div class="flex items-center gap-2 mb-3">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-[var(--accent-gold)]/15 text-[var(--accent-gold)] border border-[var(--accent-gold)]/30">
          GSI Sanctioned
        </span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono text-[var(--text-muted)] bg-[var(--bg-elevated)] border border-[var(--border-color)]">
          National Tournament Archive
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-[var(--text-main)] font-display uppercase tracking-tight leading-tight">
        Australian Grip Sport <span class="text-[var(--accent-gold)]">Championships</span>
      </h1>

      <p class="mt-4 text-lg text-[var(--text-muted)] leading-relaxed max-w-3xl">
        The pinnacle annual test of crushing, pinching, and vertical hand strength in Australia. Sanctioned under official Grip Sport International (GSI) standards, bringing together the nation's premier strength athletes.
      </p>

      <!-- Quick Nav Buttons -->
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={getUrl('/2026-championship')}
          class="px-4 py-2 rounded-[var(--btn-radius)] bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-text)] font-bold text-xs uppercase tracking-wider font-accent shadow-sm"
        >
          2026 Nationals &rarr;
        </a>
        <a
          href={getUrl('/2025-championship')}
          class="px-4 py-2 rounded-[var(--btn-radius)] bg-[var(--bg-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-main)] border border-[var(--border-color)] font-semibold text-xs uppercase tracking-wider font-accent shadow-sm"
        >
          2025 Nationals &rarr;
        </a>
        <a
          href={getUrl('/2024-championship')}
          class="px-4 py-2 rounded-[var(--btn-radius)] bg-[var(--bg-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-main)] border border-[var(--border-color)] font-semibold text-xs uppercase tracking-wider font-accent shadow-sm"
        >
          2024 Inaugural Nationals &rarr;
        </a>
      </div>
    </header>

    <!-- All-Time National Honour Roll Table -->
    <section class="mb-14">
      <div class="mb-6">
        <h2 class="text-xs font-bold text-[var(--accent-gold)] tracking-widest uppercase mb-1 font-accent">Hall of Fame</h2>
        <p class="text-2xl sm:text-3xl font-black text-[var(--text-main)] font-display uppercase">All-Time National Champions</p>
      </div>

      <div class="overflow-x-auto rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] shadow-sm">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-[var(--bg-elevated)] border-b border-[var(--border-color)] text-[var(--text-muted)] font-mono uppercase tracking-wider">
              <th class="py-3.5 px-4 font-bold">Year</th>
              <th class="py-3.5 px-4 font-bold">Host City & Venue</th>
              <th class="py-3.5 px-4 font-bold text-[var(--text-main)]">Men's Overall</th>
              <th class="py-3.5 px-4 font-bold text-[var(--text-main)]">Women's Overall</th>
              <th class="py-3.5 px-4 font-bold text-[var(--accent-gold)]">Pound-for-Pound (P4P)</th>
              <th class="py-3.5 px-4 font-bold text-right">Roster</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border-color)] text-[var(--text-main)]">
            <tr class="hover:bg-[var(--bg-elevated)]/50 transition-colors">
              <td class="py-3.5 px-4 font-mono font-bold text-sm text-[var(--accent-gold)]">2026</td>
              <td class="py-3.5 px-4 text-[var(--text-muted)]">Melbourne, VIC &bull; Iron Revolution Gym</td>
              <td class="py-3.5 px-4 font-bold">Declan Wright</td>
              <td class="py-3.5 px-4 font-bold">Megan Galvin</td>
              <td class="py-3.5 px-4 font-mono text-[var(--accent-gold)] font-semibold">Sarah Rodwell (W) &bull; Isaac Pitt (M)</td>
              <td class="py-3.5 px-4 text-right font-mono text-[var(--text-subtle)]">24 Lifters</td>
            </tr>
            <tr class="hover:bg-[var(--bg-elevated)]/50 transition-colors">
              <td class="py-3.5 px-4 font-mono font-bold text-sm text-[var(--accent-gold)]">2025</td>
              <td class="py-3.5 px-4 text-[var(--text-muted)]">Brisbane, QLD &bull; Ultra Fitness</td>
              <td class="py-3.5 px-4 font-bold">Henry Mullett</td>
              <td class="py-3.5 px-4 font-bold">Sarah Rainbow</td>
              <td class="py-3.5 px-4 font-mono text-[var(--accent-gold)] font-semibold">Isaac Pitt</td>
              <td class="py-3.5 px-4 text-right font-mono text-[var(--text-subtle)]">14 Lifters</td>
            </tr>
            <tr class="hover:bg-[var(--bg-elevated)]/50 transition-colors">
              <td class="py-3.5 px-4 font-mono font-bold text-sm text-[var(--accent-gold)]">2024</td>
              <td class="py-3.5 px-4 text-[var(--text-muted)]">Sydney, NSW &bull; Inaugural Nationals</td>
              <td class="py-3.5 px-4 font-bold">Luke Reynolds</td>
              <td class="py-3.5 px-4 text-[var(--text-subtle)]">-</td>
              <td class="py-3.5 px-4 font-mono text-[var(--accent-gold)] font-semibold">Isaac Pitt</td>
              <td class="py-3.5 px-4 text-right font-mono text-[var(--text-subtle)]">13 Lifters</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Year-by-Year Archive Cards Grid -->
    <section class="space-y-8">
      <div class="mb-4">
        <h2 class="text-xs font-bold text-[var(--accent-gold)] tracking-widest uppercase mb-1 font-accent">Year-by-Year Results</h2>
        <p class="text-2xl sm:text-3xl font-black text-[var(--text-main)] font-display uppercase">Tournament Recaps & Scoresheets</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <!-- 2026 Card -->
        <div class="bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] rounded-2xl p-6 flex flex-col justify-between shadow-sm transition-all hover:shadow-md">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono font-bold bg-[var(--accent-gold)]/15 text-[var(--accent-gold)] border border-[var(--accent-gold)]/30">
                Latest Nationals
              </span>
              <span class="text-xs font-mono text-[var(--text-muted)]">AGSC26</span>
            </div>
            
            <h3 class="text-2xl font-black font-display text-[var(--text-main)] uppercase mb-2">2026 Championship</h3>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-4">
              Held at Iron Revolution Gym in Melbourne with 24 competitors. Declan Wright took the Men's crown, Megan Galvin captured the Women's title, and Sarah Rodwell & Isaac Pitt won Pound-for-Pound honors.
            </p>

            <div class="space-y-1.5 py-3 border-y border-[var(--border-color)] text-xs">
              <div class="flex justify-between">
                <span class="text-[var(--text-muted)]">Host Venue:</span>
                <span class="font-semibold text-[var(--text-main)]">Iron Revolution (VIC)</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[var(--text-muted)]">Date:</span>
                <span class="font-mono text-[var(--text-main)]">June 27, 2026</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[var(--text-muted)]">Contested Events:</span>
                <span class="font-semibold text-[var(--text-main)]">3 Events Tracked</span>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-2">
            <a
              href={getUrl('/2026-championship')}
              class="w-full text-center py-2.5 px-4 rounded-[var(--btn-radius)] bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-text)] font-bold text-xs uppercase tracking-wider font-accent shadow-sm block transition-all"
            >
              View 2026 Full Results & Videos &rarr;
            </a>
          </div>
        </div>

        <!-- 2025 Card -->
        <div class="bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] rounded-2xl p-6 flex flex-col justify-between shadow-sm transition-all hover:shadow-md">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono text-[var(--text-muted)] bg-[var(--bg-elevated)] border border-[var(--border-color)]">
                Brisbane Nationals
              </span>
              <span class="text-xs font-mono text-[var(--text-muted)]">AGSC25</span>
            </div>
            
            <h3 class="text-2xl font-black font-display text-[var(--text-main)] uppercase mb-2">2025 Championship</h3>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-4">
              Held in Brisbane at Ultra Fitness with 14 competitors. Henry Mullett won Men's Champion, Sarah Rainbow won Women's Champion, and Isaac Pitt secured the P4P title.
            </p>

            <div class="space-y-1.5 py-3 border-y border-[var(--border-color)] text-xs">
              <div class="flex justify-between">
                <span class="text-[var(--text-muted)]">Host Venue:</span>
                <span class="font-semibold text-[var(--text-main)]">Ultra Fitness (QLD)</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[var(--text-muted)]">Date:</span>
                <span class="font-mono text-[var(--text-main)]">June 1, 2025</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[var(--text-muted)]">Contested Events:</span>
                <span class="font-semibold text-[var(--text-main)]">4 Events Tracked</span>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-2">
            <a
              href={getUrl('/2025-championship')}
              class="w-full text-center py-2.5 px-4 rounded-[var(--btn-radius)] bg-[var(--bg-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-main)] border border-[var(--border-color)] font-semibold text-xs uppercase tracking-wider font-accent shadow-sm block transition-all"
            >
              View 2025 Full Results &rarr;
            </a>
          </div>
        </div>

        <!-- 2024 Card -->
        <div class="bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] rounded-2xl p-6 flex flex-col justify-between shadow-sm transition-all hover:shadow-md">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono text-[var(--text-muted)] bg-[var(--bg-elevated)] border border-[var(--border-color)]">
                Inaugural Nationals
              </span>
              <span class="text-xs font-mono text-[var(--text-muted)]">AGSC24</span>
            </div>
            
            <h3 class="text-2xl font-black font-display text-[var(--text-main)] uppercase mb-2">2024 Championship</h3>
            <p class="text-xs text-[var(--text-muted)] leading-relaxed mb-4">
              The historic first Australian National Championship, held in Sydney. Luke Reynolds captured the inaugural Men's title, with Isaac Pitt claiming the Proportional Force / P4P Award.
            </p>

            <div class="space-y-1.5 py-3 border-y border-[var(--border-color)] text-xs">
              <div class="flex justify-between">
                <span class="text-[var(--text-muted)]">Host Location:</span>
                <span class="font-semibold text-[var(--text-main)]">Sydney (NSW)</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[var(--text-muted)]">Date:</span>
                <span class="font-mono text-[var(--text-main)]">June 1, 2024</span>
              </div>
              <div class="flex justify-between">
                <span class="text-[var(--text-muted)]">Contested Events:</span>
                <span class="font-semibold text-[var(--text-main)]">4 Events Tracked</span>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-2">
            <a
              href={getUrl('/2024-championship')}
              class="w-full text-center py-2.5 px-4 rounded-[var(--btn-radius)] bg-[var(--bg-elevated)] hover:bg-[var(--bg-surface)] text-[var(--text-main)] border border-[var(--border-color)] font-semibold text-xs uppercase tracking-wider font-accent shadow-sm block transition-all"
            >
              View 2024 Full Results &rarr;
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- Footer link -->
    <footer class="mt-16 pt-8 border-t border-[var(--border-color)] flex items-center justify-between text-xs text-[var(--text-muted)]">
      <a
        href={getUrl('/')}
        class="inline-flex items-center gap-1.5 text-[var(--accent-gold)] hover:underline font-accent uppercase tracking-wider font-semibold"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span>Back to Homepage</span>
      </a>

      <a
        href={getUrl('/records')}
        class="hover:text-[var(--accent-gold)] transition-colors font-accent uppercase tracking-wider font-semibold"
      >
        View Australian Records Registry &rarr;
      </a>
    </footer>

  </div>
</BaseLayout>
