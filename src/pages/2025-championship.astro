---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getUrl } from '../utils/url';

import podiumImg from '../assets/images/2025-championship-b3c7cad5.jpg';
import scorecardImg from '../assets/images/2025-championship-3a326477.png';
import groupImg from '../assets/images/2025-championship-c89d7517.jpg';
import posterImg from '../assets/images/2025-championship-567c5b38.jpg';
import action1Img from '../assets/images/2025-championship-d44d2256.jpeg';
import action2Img from '../assets/images/2025-championship-1fd8e2cb.jpeg';
import action3Img from '../assets/images/2025-championship-c54b74d4.jpeg';

const womensResults = [
  { rank: 1, name: 'Sarah Rainbow', division: 'Womens 100k', nn: '100.70 kg', pinch: '66.30 kg', cannon: '72.60 kg', silverBullet: '-', overallRank: 1, p4pRank: '1st P4P', honor: '🥇 Overall Women\'s Champion' },
];

const mensResults = [
  { rank: 1, name: 'Henry Mullett', division: 'Mens 120k+', nn: '185.70 kg', pinch: '121.30 kg', cannon: '127.60 kg', silverBullet: '10.51s (#3.5)', overallRank: 1, p4pRank: null, honor: '🥇 Overall Men\'s Champion' },
  { rank: 2, name: 'Isaac Pitt', division: 'Mens 83k', nn: '170.70 kg', pinch: '106.30 kg', cannon: '127.60 kg', silverBullet: '22.04s (#3)', overallRank: 2, p4pRank: '1st P4P', honor: '🥈 2nd Overall' },
  { rank: 3, name: 'Lachlan Simms', division: 'Mens 120k+', nn: '185.70 kg', pinch: '106.30 kg', cannon: '102.60 kg', silverBullet: '3.57s (#3)', overallRank: 3, p4pRank: null, honor: '🥉 3rd Overall' },
  { rank: 4, name: 'Mathew Wayling', division: 'Mens 120k+', nn: '150.70 kg', pinch: '106.30 kg', cannon: '107.60 kg', silverBullet: '7.23s (#3)', overallRank: 4, p4pRank: null, honor: '4th' },
  { rank: 5, name: 'Dominic Awad', division: 'Mens 120k', nn: '158.20 kg', pinch: '96.30 kg', cannon: '112.60 kg', silverBullet: '1.09s (#3.5)', overallRank: 5, p4pRank: null, honor: '5th' },
  { rank: 6, name: 'Will Fuggle', division: 'Mens 83k', nn: '150.70 kg', pinch: '106.30 kg', cannon: '117.60 kg', silverBullet: '-', overallRank: 6, p4pRank: '3rd P4P', honor: '6th' },
  { rank: 7, name: 'Tom Denmeade', division: 'Mens 74k', nn: '140.70 kg', pinch: '91.30 kg', cannon: '107.60 kg', silverBullet: '11.92s (#3)', overallRank: 7, p4pRank: '2nd P4P', honor: '7th' },
  { rank: 8, name: 'Glenn Hunter', division: 'Mens 120k+', nn: '140.70 kg', pinch: '96.30 kg', cannon: '97.60 kg', silverBullet: '-', overallRank: 8, p4pRank: null, honor: '8th' },
  { rank: 9, name: 'Samuel Farbach', division: 'Mens 93k', nn: '140.70 kg', pinch: '71.30 kg', cannon: '97.60 kg', silverBullet: '-', overallRank: 9, p4pRank: null, honor: '9th' },
  { rank: 10, name: 'Mark Boylin', division: 'Mens 105k', nn: '125.70 kg', pinch: '76.30 kg', cannon: '87.60 kg', silverBullet: '-', overallRank: 10, p4pRank: null, honor: '10th' },
  { rank: 11, name: 'Jaksen Daddo', division: 'Mens 120k', nn: '130.70 kg', pinch: '86.30 kg', cannon: '87.60 kg', silverBullet: '-', overallRank: 11, p4pRank: null, honor: '11th' },
  { rank: 12, name: 'Matthew Shaw', division: 'Mens 74k', nn: '110.70 kg', pinch: '61.30 kg', cannon: '82.60 kg', silverBullet: '-', overallRank: 12, p4pRank: null, honor: '12th' },
  { rank: 13, name: 'Josh Cook', division: 'Mens 105k', nn: '110.70 kg', pinch: '56.30 kg', cannon: '67.60 kg', silverBullet: '-', overallRank: 13, p4pRank: null, honor: '13th' },
];
---

<BaseLayout
  title="2025 Australian Grip Sport Championship | Grip Australia"
  description="Official results, photos, and highlights from the 2025 Australian Grip Sport Championship held in Brisbane, QLD."
>
  <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center space-x-2 text-xs text-[var(--text-muted)] mb-6 font-mono" aria-label="Breadcrumb">
      <a href={getUrl('/')} class="hover:text-[var(--accent-gold)] transition-colors">Home</a>
      <span>/</span>
      <a href={getUrl('/championships')} class="hover:text-[var(--accent-gold)] transition-colors">National Championships</a>
      <span>/</span>
      <span class="text-[var(--text-main)] truncate font-semibold">2025 Championship</span>
    </nav>

    <!-- Header Section -->
    <header class="text-center pb-8 mb-8 border-b border-[var(--border-color)]">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-[var(--text-main)] font-display uppercase tracking-tight leading-tight">
        2025 Australian Grip Sport Championship
      </h1>
      <p class="mt-3 text-base sm:text-lg text-[var(--text-muted)] max-w-2xl mx-auto leading-relaxed">
        June 1, 2025 • Ultra Fitness &amp; Strength / Steel Stone Gym, Brisbane, QLD • GSI Sanctioned
      </p>
      
      <div class="mt-4 flex flex-wrap justify-center items-center gap-2">
        <span class="px-2.5 py-0.5 rounded bg-[var(--bg-elevated)] text-[var(--accent-gold)] font-mono text-xs font-semibold border border-[var(--accent-gold)]/30">
          #grip sport
        </span>
        <span class="px-2.5 py-0.5 rounded bg-[var(--bg-elevated)] text-[var(--text-muted)] font-mono text-xs border border-[var(--border-color)]">
          #australia
        </span>
        <span class="px-2.5 py-0.5 rounded bg-[var(--bg-elevated)] text-[var(--text-muted)] font-mono text-xs border border-[var(--border-color)]">
          #championship
        </span>
        <span class="px-2.5 py-0.5 rounded bg-[var(--bg-elevated)] text-[var(--text-muted)] font-mono text-xs border border-[var(--border-color)]">
          #competition
        </span>
      </div>
    </header>

    <!-- Podium & Feature Visual Grid (Matching 2026 Layout) -->
    <section class="my-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start text-center">
        
        <!-- Men's Podium (Left) -->
        <div class="flex flex-col items-center">
          <div class="w-full max-w-[320px] aspect-4/3 rounded-xl overflow-hidden shadow-md border border-[var(--border-color)] bg-[var(--bg-surface)] mb-4">
            <Image
              src={podiumImg}
              alt="Men's Podium - 2025 Australian Grip Sport Championship"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
          <h3 class="font-display font-black text-xl uppercase tracking-wide text-[var(--text-main)] mb-1">
            Men's Podium
          </h3>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed max-w-[280px]">
            Lachlan Simms (3rd), Henry Mullett (1st &amp; Champion) &amp; Isaac Pitt (2nd &amp; Pound-for-Pound Champion)
          </p>
        </div>

        <!-- Competitors Group Photo (Center - Circular Frame) -->
        <div class="flex flex-col items-center">
          <div class="w-64 h-64 sm:w-72 sm:h-72 rounded-full overflow-hidden shadow-xl border-4 border-[var(--accent-gold)] bg-[var(--bg-surface)] mb-4 p-1">
            <Image
              src={groupImg}
              alt="2025 Australian Grip Championship Competitors"
              class="w-full h-full object-cover rounded-full"
              loading="eager"
            />
          </div>
          <h3 class="font-display font-black text-xl uppercase tracking-wide text-[var(--accent-gold)] mb-1">
            Competitors
          </h3>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed max-w-[280px]">
            14 Competitors gathered in Brisbane for the second annual Australian National Championships
          </p>
        </div>

        <!-- Official Poster (Right) -->
        <div class="flex flex-col items-center">
          <div class="w-full max-w-[320px] aspect-4/3 rounded-xl overflow-hidden shadow-md border border-[var(--border-color)] bg-[var(--bg-surface)] mb-4">
            <Image
              src={posterImg}
              alt="Official 2025 Championship Poster autographed by athletes"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
          <h3 class="font-display font-black text-xl uppercase tracking-wide text-[var(--text-main)] mb-1">
            Championship Art
          </h3>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed max-w-[280px]">
            Official commemorative Brisbane Ibis poster autographed by all 2025 competitors &amp; sponsors
          </p>
        </div>

      </div>
    </section>

    <!-- Pound-for-Pound & GSI Sanctioning Callout -->
    <div class="my-8 p-5 rounded-xl border border-[var(--accent-gold)]/40 bg-[var(--bg-surface)] shadow-md">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="text-[11px] font-mono uppercase tracking-widest text-[var(--accent-gold)] font-bold mb-1">
            National Recognition • Proportional Force
          </div>
          <h2 class="font-display font-black text-lg text-[var(--text-main)] uppercase tracking-wide">
            2025 Champions &amp; Proportional Force Honors
          </h2>
          <div class="mt-2 flex flex-wrap gap-x-6 gap-y-1 text-sm text-[var(--text-main)]">
            <div>🏆 <span class="font-bold">Henry Mullett</span> <span class="text-xs text-[var(--text-muted)]">(Overall Men's Champion)</span></div>
            <div>🏆 <span class="font-bold">Sarah Rainbow</span> <span class="text-xs text-[var(--text-muted)]">(Overall Women's Champion)</span></div>
            <div>🏆 <span class="font-bold">Isaac Pitt</span> <span class="text-xs text-[var(--text-muted)]">(Men's P4P Champion: 1st Weight Placing)</span></div>
          </div>
        </div>

        <a
          href="https://www.gripsport.org/contest/433"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 px-4 py-2.5 rounded-lg bg-[var(--bg-elevated)] border border-[var(--accent-gold)]/50 hover:border-[var(--accent-gold)] text-[var(--accent-gold)] text-xs font-accent font-bold uppercase tracking-wider transition-all flex items-center justify-center gap-1.5 shadow-sm hover:bg-[var(--accent-gold)] hover:text-black"
        >
          <span>View GSI Contest #433</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
      </div>
    </div>

    <!-- Official Results Section -->
    <section class="my-12">
      <div class="flex items-center justify-between pb-3 mb-6 border-b border-[var(--border-color)]">
        <div>
          <h2 class="font-display font-black text-2xl uppercase tracking-tight text-[var(--text-main)]">
            Official Championship Results
          </h2>
          <p class="text-xs text-[var(--text-muted)] mt-0.5">
            Verified data extracted from sanctioned scorecards and Grip Sport International (GSI)
          </p>
        </div>
      </div>

      <!-- Women's Results Table -->
      <div class="mb-10">
        <h3 class="font-display font-bold text-lg uppercase tracking-wide text-[var(--accent-gold)] mb-3 flex items-center gap-2">
          <span>Women's Championship</span>
        </h3>
        
        <div class="overflow-x-auto rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] shadow-sm">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="bg-[var(--bg-elevated)] text-[var(--text-main)] font-mono text-[11px] uppercase tracking-wider border-b border-[var(--border-color)]">
                <th class="py-3 px-3 w-12 text-center">Rank</th>
                <th class="py-3 px-3">Athlete</th>
                <th class="py-3 px-3">Division</th>
                <th class="py-3 px-3 text-right">Napalm's 2.375"</th>
                <th class="py-3 px-3 text-right">2-Hand Pinch</th>
                <th class="py-3 px-3 text-right">Vertical Cannon</th>
                <th class="py-3 px-3 text-right">Silver Bullet</th>
                <th class="py-3 px-3 text-right font-bold text-[var(--accent-gold)]">P4P Rank</th>
                <th class="py-3 px-3 text-center">Honors</th>
              </tr>
            </thead>
            <tbody>
              {womensResults.map(row => (
                <tr class="hover:bg-[var(--bg-elevated)]/60 transition-colors">
                  <td class="py-3 px-3 font-mono font-bold text-center text-[var(--text-muted)]">{row.rank}</td>
                  <td class="py-3 px-3 font-bold text-[var(--text-main)]">{row.name}</td>
                  <td class="py-3 px-3 text-[var(--text-muted)] font-mono text-xs">{row.division}</td>
                  <td class="py-3 px-3 text-right font-mono font-semibold">{row.nn}</td>
                  <td class="py-3 px-3 text-right font-mono font-semibold">{row.pinch}</td>
                  <td class="py-3 px-3 text-right font-mono font-semibold">{row.cannon}</td>
                  <td class="py-3 px-3 text-right font-mono">{row.silverBullet}</td>
                  <td class="py-3 px-3 text-right font-mono">
                    <span class="px-2 py-0.5 rounded bg-amber-400/20 text-amber-500 font-bold border border-amber-400/40">
                      {row.p4pRank}
                    </span>
                  </td>
                  <td class="py-3 px-3 text-center font-accent font-semibold text-xs text-[var(--accent-gold)]">
                    {row.honor}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Men's Results Table -->
      <div class="mb-10">
        <h3 class="font-display font-bold text-lg uppercase tracking-wide text-[var(--accent-gold)] mb-3 flex items-center gap-2">
          <span>Men's Championship</span>
          <span class="text-xs font-mono text-[var(--text-muted)] font-normal">(13 Competitors)</span>
        </h3>
        
        <div class="overflow-x-auto rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] shadow-sm">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="bg-[var(--bg-elevated)] text-[var(--text-main)] font-mono text-[11px] uppercase tracking-wider border-b border-[var(--border-color)]">
                <th class="py-3 px-3 w-12 text-center">Rank</th>
                <th class="py-3 px-3">Athlete</th>
                <th class="py-3 px-3">Division</th>
                <th class="py-3 px-3 text-right">Napalm's 2.375"</th>
                <th class="py-3 px-3 text-right">2-Hand Pinch</th>
                <th class="py-3 px-3 text-right">Vertical Cannon</th>
                <th class="py-3 px-3 text-right">Silver Bullet</th>
                <th class="py-3 px-3 text-right font-bold text-[var(--accent-gold)]">P4P Rank</th>
                <th class="py-3 px-3 text-center">Honors</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border-color)]/50">
              {mensResults.map(row => (
                <tr class="hover:bg-[var(--bg-elevated)]/60 transition-colors">
                  <td class="py-3 px-3 font-mono font-bold text-center text-[var(--text-muted)]">{row.rank}</td>
                  <td class="py-3 px-3 font-bold text-[var(--text-main)]">{row.name}</td>
                  <td class="py-3 px-3 text-[var(--text-muted)] font-mono text-xs">{row.division}</td>
                  <td class="py-3 px-3 text-right font-mono font-semibold">{row.nn}</td>
                  <td class="py-3 px-3 text-right font-mono font-semibold">{row.pinch}</td>
                  <td class="py-3 px-3 text-right font-mono font-semibold">{row.cannon}</td>
                  <td class="py-3 px-3 text-right font-mono">{row.silverBullet}</td>
                  <td class="py-3 px-3 text-right font-mono">
                    <span class:list={[
                      "px-2 py-0.5 rounded",
                      row.p4pRank === '1st P4P' ? "bg-amber-400/20 text-amber-500 font-bold border border-amber-400/40" :
                      row.p4pRank === '2nd P4P' ? "bg-slate-300/20 text-slate-300 font-bold border border-slate-300/30" :
                      row.p4pRank === '3rd P4P' ? "bg-amber-700/20 text-amber-700 font-bold border border-amber-700/30" :
                      "text-[var(--text-muted)]"
                    ]}>
                      {row.p4pRank ? row.p4pRank : '-'}
                    </span>
                  </td>
                  <td class="py-3 px-3 text-center font-accent font-semibold text-xs">
                    {row.honor}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

    </section>

    <!-- Action Photos Gallery (Preserved from Original Site) -->
    <section class="my-12">
      <div class="pb-3 mb-6 border-b border-[var(--border-color)]">
        <h2 class="font-display font-black text-2xl uppercase tracking-tight text-[var(--text-main)]">
          Event Gallery &amp; Highlights
        </h2>
        <p class="text-xs text-[var(--text-muted)] mt-0.5">
          Trophy presentations, Five Arms implement testing, and competition action in Brisbane
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="rounded-xl overflow-hidden shadow-md border border-[var(--border-color)] bg-[var(--bg-surface)] flex flex-col">
          <div class="aspect-4/3 w-full overflow-hidden">
            <Image
              src={action1Img}
              alt="Isaac Pitt presenting Henry Mullett with Champion trophy"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            />
          </div>
          <p class="p-3 text-xs text-[var(--text-muted)] text-center font-medium">
            Trophy presentation to Men's Champion Henry Mullett
          </p>
        </div>

        <div class="rounded-xl overflow-hidden shadow-md border border-[var(--border-color)] bg-[var(--bg-surface)] flex flex-col">
          <div class="aspect-4/3 w-full overflow-hidden">
            <Image
              src={action2Img}
              alt="Isaac Pitt and Tom Denmeade with Five Arms implement"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            />
          </div>
          <p class="p-3 text-xs text-[var(--text-muted)] text-center font-medium">
            Five Arms implement showcase with Tom Denmeade
          </p>
        </div>

        <div class="rounded-xl overflow-hidden shadow-md border border-[var(--border-color)] bg-[var(--bg-surface)] flex flex-col sm:col-span-2 md:col-span-1">
          <div class="aspect-4/3 w-full overflow-hidden">
            <Image
              src={action3Img}
              alt="Competitors gathered at the score and award table"
              class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            />
          </div>
          <p class="p-3 text-xs text-[var(--text-muted)] text-center font-medium">
            Athletes and judges around the championship score table
          </p>
        </div>
      </div>
    </section>

    <!-- Tournament Sponsors & Host Venue Section -->
    <section class="my-12 p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] shadow-md">
      <div class="max-w-3xl">
        <div class="text-[11px] font-mono uppercase tracking-widest text-[var(--accent-gold)] font-bold mb-1">
          Official Recognition
        </div>
        <h2 class="font-display font-black text-2xl uppercase tracking-tight text-[var(--text-main)] mb-3">
          Event Sponsors &amp; Host Venue
        </h2>
        <p class="text-sm text-[var(--text-muted)] leading-relaxed mb-6">
          This event was sponsored by <strong>Climbing Anchors</strong>, <strong>Arm Assassin Strength Shop</strong>, <strong>Nemesis Grips</strong>, <strong>The Grip Show</strong>, <strong>Cannon PowerWorks</strong>, and <strong>Five Arms</strong>.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div class="p-4 rounded-xl bg-[var(--bg-elevated)] border border-[var(--border-color)]">
            <div class="text-xs font-mono text-[var(--accent-gold)] uppercase font-bold mb-1">Host Venue</div>
            <div class="font-bold text-[var(--text-main)]">Ultra Fitness &amp; Strength / Steel Stone Gym</div>
            <p class="text-xs text-[var(--text-muted)] mt-1">Brisbane, Queensland</p>
          </div>

          <div class="p-4 rounded-xl bg-[var(--bg-elevated)] border border-[var(--border-color)]">
            <div class="text-xs font-mono text-[var(--accent-gold)] uppercase font-bold mb-1">Sanctioning Body</div>
            <a
              href="https://www.gripsport.org"
              target="_blank"
              rel="noopener noreferrer"
              class="font-bold text-[var(--text-main)] hover:text-[var(--accent-gold)] flex items-center gap-1 transition-colors"
            >
              <span>Grip Sport International (GSI)</span>
              <svg class="w-3.5 h-3.5 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
            <p class="text-xs text-[var(--text-muted)] mt-1">International rules &amp; rankings standard</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Page Footer / Navigation -->
    <footer class="mt-16 pt-8 border-t border-[var(--border-color)] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--text-muted)]">
      <a
        href={getUrl('/championships')}
        class="inline-flex items-center gap-1.5 text-[var(--accent-gold)] hover:underline font-accent uppercase tracking-wider font-semibold"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        <span>Back to National Championships Hub</span>
      </a>

      <span class="text-[var(--text-subtle)] text-[11px]">
        Official record archived under Grip Sport International #433
      </span>
    </footer>

  </article>
</BaseLayout>
