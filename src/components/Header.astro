---
import { getUrl } from '../utils/url';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const recordLinks = [
  { href: getUrl('/records'), label: 'Australian Records', desc: 'National rankings, weight classes & lift leaderboards' },
  { href: getUrl('/australian-grip-feats'), label: 'Australian Grip Feats', desc: 'Thomas Inch, Blobs & historic odd-object lifts' },
  { href: getUrl('/mulletts-mandrel'), label: "Mullett's Mandrel Records", desc: 'Australian wrist wrench rules, history & records' },
];

const competitionLinks = [
  { href: getUrl('/competition-calendar'), label: 'Competition Calendar', desc: 'Upcoming GSI-sanctioned events & local meets' },
  { href: getUrl('/championships'), label: 'National Championships', desc: 'Tournament archives & champion honour roll (2024–2026)' },
];

const resourceLinks = [
  { href: getUrl('/useful-resources'), label: 'Useful Sites & Resources', desc: 'Governing bodies, forums, equipment & training directories' },
  { href: getUrl('/equipment-guide'), label: "Beginner's Equipment Guide", desc: 'IM Tugs, loading pins, chalk & pinch blocks' },
  { href: getUrl('/gripper-rating-service'), label: 'Gripper Rating Service', desc: "Artie's Grip Gym RGC calibration & testing" },
  { href: getUrl('/media'), label: 'Interviews & Media', desc: 'Athlete interviews, podcasts & video analysis' },
];

const isRecordsActive = ['/records', '/australian-grip-feats', '/mulletts-mandrel'].some(path => currentPath.includes(path));
const isCompetitionsActive = ['/competition-calendar', '/championships', '/2024-championship', '/2025-championship', '/2026-championship'].some(path => currentPath.includes(path));
const isResourcesActive = ['/useful-resources', '/resources', '/equipment-guide', '/gripper-rating-service', '/media'].some(path => currentPath.includes(path));
const isWhatIsGripActive = currentPath.includes('/what-is-grip-sport');
---

<header class="sticky top-0 z-40 w-full border-b border-[var(--border-color)] bg-[var(--bg-base)]/95 backdrop-blur-md transition-colors duration-250">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      
      <!-- Brand Logo & Interactive Gripper Theme Toggle -->
      <div class="flex items-center space-x-3">
        <!-- Interactive Small Grip Logo Button -->
        <button
          id="header-grip-logo-toggle"
          type="button"
          class="brand-icon-toggle group relative w-10 h-10 rounded-lg flex items-center justify-center transition-all duration-200 cursor-pointer shadow-md hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-[var(--accent-gold)]"
          style="background: linear-gradient(135deg, var(--logo-bg-from), var(--logo-bg-to)); border: 1px solid var(--logo-border); color: var(--logo-icon-color);"
          title="Click gripper to toggle: Calibrated (Light) ↔ Outback (Dark)"
          aria-label="Toggle between Calibrated Minimalism light mode and Outback Ochre dark mode"
        >
          <svg class="gripper-svg w-6 h-6" viewBox="0 0 100 100" fill="none">
            <circle class="gripper-coil" cx="50" cy="32" r="16" stroke="currentColor" stroke-width="8"/>
            <path class="gripper-handle-left" d="M38 36 L24 82" stroke="currentColor" stroke-width="9" stroke-linecap="round"/>
            <path class="gripper-handle-right" d="M62 36 L76 82" stroke="currentColor" stroke-width="9" stroke-linecap="round"/>
          </svg>
        </button>

        <div>
          <a href={getUrl('/')} class="font-display font-black text-xl tracking-wider uppercase block leading-tight hover:opacity-90 transition-opacity">
            <span class="text-[var(--text-main)]">Grip</span><span class="text-[var(--accent-gold)]">Australia</span>
          </a>
          <span class="text-[10px] tracking-widest text-[var(--text-muted)] font-semibold uppercase block">Just Grip It</span>
        </div>
      </div>

      <!-- Desktop Streamlined Navigation -->
      <nav class="hidden lg:flex items-center space-x-1" aria-label="Main Navigation">
        
        <!-- Top-level: What is Grip Sport? -->
        <a
          href={getUrl('/what-is-grip-sport')}
          class:list={[
            "px-3 py-2 rounded-md text-sm font-medium transition-colors cursor-pointer flex items-center gap-1.5",
            isWhatIsGripActive
              ? "bg-[var(--bg-elevated)] text-[var(--text-main)] border border-[var(--border-color)] font-semibold"
              : "text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-elevated)]"
          ]}
        >
          <span>What is Grip Sport?</span>
        </a>
        
        <!-- Dropdown: Records & Feats -->
        <div class="relative group">
          <button
            type="button"
            class:list={[
              "nav-dropdown-trigger flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors cursor-pointer",
              isRecordsActive
                ? "bg-[var(--bg-elevated)] text-[var(--text-main)] border border-[var(--border-color)] font-semibold"
                : "text-[var(--text-muted)] group-hover:text-[var(--text-main)] group-hover:bg-[var(--bg-elevated)]"
            ]}
            aria-expanded="false"
          >
            <span>Records & Feats</span>
            <svg class="w-4 h-4 text-[var(--text-subtle)] group-hover:text-[var(--accent-gold)] transition-transform group-hover:rotate-180 duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>

          <!-- Dropdown Menu -->
          <div class="absolute left-0 top-full pt-2 w-80 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-150 transform group-hover:translate-y-0 translate-y-1 z-50">
            <div class="p-2 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)] shadow-xl space-y-1">
              {recordLinks.map(link => (
                <a
                  href={link.href}
                  class="block p-2.5 rounded-lg hover:bg-[var(--bg-elevated)] transition-colors group/item"
                >
                  <div class="font-display font-bold text-sm text-[var(--text-main)] group-hover/item:text-[var(--accent-gold)] uppercase tracking-wide flex items-center justify-between">
                    <span>{link.label}</span>
                    <span class="text-[10px] text-[var(--accent-gold)] opacity-0 group-hover/item:opacity-100 transition-opacity font-accent">&rarr;</span>
                  </div>
                  <p class="text-[11px] text-[var(--text-muted)] mt-0.5 leading-snug">{link.desc}</p>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Dropdown: Competitions -->
        <div class="relative group">
          <button
            type="button"
            class:list={[
              "nav-dropdown-trigger flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors cursor-pointer",
              isCompetitionsActive
                ? "bg-[var(--bg-elevated)] text-[var(--text-main)] border border-[var(--border-color)] font-semibold"
                : "text-[var(--text-muted)] group-hover:text-[var(--text-main)] group-hover:bg-[var(--bg-elevated)]"
            ]}
            aria-expanded="false"
          >
            <span>Competitions</span>
            <svg class="w-4 h-4 text-[var(--text-subtle)] group-hover:text-[var(--accent-gold)] transition-transform group-hover:rotate-180 duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>

          <!-- Dropdown Menu -->
          <div class="absolute left-0 top-full pt-2 w-72 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-150 transform group-hover:translate-y-0 translate-y-1 z-50">
            <div class="p-2 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)] shadow-xl space-y-1">
              {competitionLinks.map(link => (
                <a
                  href={link.href}
                  class="block p-2.5 rounded-lg hover:bg-[var(--bg-elevated)] transition-colors group/item"
                >
                  <div class="font-display font-bold text-sm text-[var(--text-main)] group-hover/item:text-[var(--accent-gold)] uppercase tracking-wide flex items-center justify-between">
                    <span>{link.label}</span>
                    <span class="text-[10px] text-[var(--accent-gold)] opacity-0 group-hover/item:opacity-100 transition-opacity font-accent">&rarr;</span>
                  </div>
                  <p class="text-[11px] text-[var(--text-muted)] mt-0.5 leading-snug">{link.desc}</p>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Dropdown: Resources & Tools -->
        <div class="relative group">
          <button
            type="button"
            class:list={[
              "nav-dropdown-trigger flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors cursor-pointer",
              isResourcesActive
                ? "bg-[var(--bg-elevated)] text-[var(--text-main)] border border-[var(--border-color)] font-semibold"
                : "text-[var(--text-muted)] group-hover:text-[var(--text-main)] group-hover:bg-[var(--bg-elevated)]"
            ]}
            aria-expanded="false"
          >
            <span>Resources</span>
            <svg class="w-4 h-4 text-[var(--text-subtle)] group-hover:text-[var(--accent-gold)] transition-transform group-hover:rotate-180 duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>

          <!-- Dropdown Menu -->
          <div class="absolute left-0 top-full pt-2 w-80 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-150 transform group-hover:translate-y-0 translate-y-1 z-50">
            <div class="p-2 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-color)] shadow-xl space-y-1">
              {resourceLinks.map(link => (
                <a
                  href={link.href}
                  class="block p-2.5 rounded-lg hover:bg-[var(--bg-elevated)] transition-colors group/item"
                >
                  <div class="font-display font-bold text-sm text-[var(--text-main)] group-hover/item:text-[var(--accent-gold)] uppercase tracking-wide flex items-center justify-between">
                    <span>{link.label}</span>
                    <span class="text-[10px] text-[var(--accent-gold)] opacity-0 group-hover/item:opacity-100 transition-opacity font-accent">&rarr;</span>
                  </div>
                  <p class="text-[11px] text-[var(--text-muted)] mt-0.5 leading-snug">{link.desc}</p>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Action Item: Get Involved CTA Button -->
        <div class="pl-2">
          <a
            href={getUrl('/get-involved')}
            class="px-4 py-2 rounded-[var(--btn-radius)] bg-[var(--accent)] hover:bg-[var(--accent-hover)] text-[var(--accent-text)] font-accent font-bold text-xs uppercase tracking-wider transition-all duration-200 shadow-sm hover:shadow border border-[var(--accent-gold)]/40 hover:border-[var(--accent-gold)] flex items-center gap-1.5 transform hover:-translate-y-0.5"
          >
            <span>Get Involved</span>
            <svg class="w-3.5 h-3.5 text-[var(--accent-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>

      </nav>

      <!-- Search Trigger & Mobile Menu Button -->
      <div class="flex items-center space-x-2">
        <button
          id="search-toggle-btn"
          type="button"
          aria-label="Search website"
          class="p-2 text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-elevated)] rounded-lg border border-[var(--border-color)] transition-colors flex items-center space-x-2 text-sm"
        >
          <svg class="w-4 h-4 text-[var(--accent-gold)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <span class="hidden sm:inline text-xs text-[var(--text-muted)] font-mono">Search</span>
        </button>

        <!-- Mobile menu toggle button -->
        <button
          id="mobile-menu-btn"
          type="button"
          aria-expanded="false"
          aria-label="Toggle mobile menu"
          class="lg:hidden p-2 text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-elevated)] rounded-lg border border-[var(--border-color)]"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-b border-[var(--border-color)] bg-[var(--bg-surface)] px-4 pt-3 pb-6 space-y-4">
    
    <!-- Top Row: Get Involved CTA & What is Grip Sport -->
    <div class="pb-3 border-b border-[var(--border-color)] space-y-2">
      <a
        href={getUrl('/get-involved')}
        class="block w-full text-center py-2.5 px-3 rounded-lg bg-[var(--accent)] text-[var(--accent-text)] border border-[var(--accent-gold)]/40 text-xs font-bold uppercase font-accent tracking-wider shadow-sm"
      >
        Get Involved
      </a>
      <a
        href={getUrl('/what-is-grip-sport')}
        class:list={[
          "block w-full text-center py-2 px-3 rounded-lg text-xs font-bold uppercase font-accent tracking-wider transition-colors",
          isWhatIsGripActive
            ? "bg-[var(--bg-elevated)] text-[var(--text-main)] border border-[var(--border-color)]"
            : "bg-[var(--bg-elevated)]/60 text-[var(--text-main)] hover:bg-[var(--bg-elevated)] border border-[var(--border-color)]"
        ]}
      >
        What is Grip Sport?
      </a>
    </div>

    <!-- Records & Feats Group -->
    <div class="space-y-1">
      <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-[var(--accent-gold)] px-2">Records & Feats</div>
      {recordLinks.map(link => (
        <a
          href={link.href}
          class="block px-2.5 py-2 rounded-md text-sm font-medium text-[var(--text-main)] hover:bg-[var(--bg-elevated)]"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Competitions Group -->
    <div class="space-y-1 pt-2 border-t border-[var(--border-color)]">
      <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-[var(--accent-gold)] px-2">Competitions</div>
      {competitionLinks.map(link => (
        <a
          href={link.href}
          class="block px-2.5 py-2 rounded-md text-sm font-medium text-[var(--text-main)] hover:bg-[var(--bg-elevated)]"
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Resources Group -->
    <div class="space-y-1 pt-2 border-t border-[var(--border-color)]">
      <div class="text-[10px] font-mono font-bold uppercase tracking-wider text-[var(--accent-gold)] px-2">Resources & Tools</div>
      {resourceLinks.map(link => (
        <a
          href={link.href}
          class="block px-2.5 py-2 rounded-md text-sm font-medium text-[var(--text-main)] hover:bg-[var(--bg-elevated)]"
        >
          {link.label}
        </a>
      ))}
    </div>

  </div>
</header>

<script>
  // Mobile drawer logic
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileBtn?.addEventListener('click', () => {
    const isExpanded = mobileBtn.getAttribute('aria-expanded') === 'true';
    mobileBtn.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
  });

  // Interactive Hand Gripper Mode Switcher logic
  function updateThemeUI(theme: string) {
    const toggleBtn = document.getElementById('header-grip-logo-toggle');

    if (theme === 'outback') {
      if (toggleBtn) toggleBtn.setAttribute('title', '🌙 Dark Mode (Outback) • Click gripper to crush into Calibrated Light');
    } else {
      if (toggleBtn) toggleBtn.setAttribute('title', '☀️ Light Mode (Calibrated) • Click gripper to crush into Outback Dark');
    }
  }

  function toggleTheme(e?: Event) {
    if (e) e.preventDefault();
    const toggleBtn = document.getElementById('header-grip-logo-toggle');
    if (toggleBtn) {
      toggleBtn.classList.add('crushing');
      setTimeout(() => toggleBtn.classList.remove('crushing'), 350);
    }

    const currentTheme = document.documentElement.getAttribute('data-theme') || 'calibrated';
    const newTheme = (currentTheme === 'calibrated') ? 'outback' : 'calibrated';
    
    document.documentElement.setAttribute('data-theme', newTheme);
    try {
      localStorage.setItem('ga-theme', newTheme);
      localStorage.setItem('ga-preferred-mode', newTheme === 'outback' ? 'theme-2' : 'theme-6');
    } catch (err) {}

    updateThemeUI(newTheme);
  }

  const toggleBtn = document.getElementById('header-grip-logo-toggle');
  toggleBtn?.addEventListener('click', toggleTheme);

  // Sync with current theme on page load
  const initialTheme = document.documentElement.getAttribute('data-theme') || 'calibrated';
  updateThemeUI(initialTheme);
</script>
