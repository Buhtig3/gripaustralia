---
interface Props {
  name: string;
  state: 'ACT' | 'NSW' | 'NT' | 'QLD' | 'SA' | 'TAS' | 'VIC' | 'WA';
  suburb?: string;
  equipment: string[];
  description?: string;
  website?: string;
  featured?: boolean;
}

const {
  name,
  state,
  suburb,
  equipment = [],
  description,
  website,
  featured = false,
} = Astro.props;

const stateColorMap: Record<string, string> = {
  ACT: 'bg-blue-500/10 text-blue-400 border-blue-500/30',
  NSW: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/30',
  NT: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
  QLD: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  SA: 'bg-red-500/10 text-red-400 border-red-500/30',
  TAS: 'bg-teal-500/10 text-teal-400 border-teal-500/30',
  VIC: 'bg-indigo-500/10 text-indigo-400 border-indigo-500/30',
  WA: 'bg-yellow-500/10 text-yellow-400 border-yellow-500/30',
};
---

<div
  class="gym-card group relative bg-slate-900/80 border border-slate-800 hover:border-orange-500/50 rounded-xl p-6 transition-all duration-200 hover:shadow-xl hover:shadow-orange-500/5 flex flex-col justify-between"
  data-state={state}
>
  <div>
    <!-- Header: State Badge and Title -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div>
        <div class="flex items-center gap-2">
          <h3 class="text-xl font-bold text-white group-hover:text-orange-400 transition-colors">
            {name}
          </h3>
          {featured && (
            <span class="px-1.5 py-0.5 text-[10px] font-semibold rounded bg-orange-500/10 text-orange-400 border border-orange-500/30">
              Featured
            </span>
          )}
        </div>
        {suburb && (
          <p class="text-xs text-slate-400 flex items-center gap-1 mt-1">
            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>{suburb}, {state}</span>
          </p>
        )}
      </div>

      <span class:list={[
        "px-2.5 py-1 text-xs font-bold rounded-md border tracking-wide uppercase",
        stateColorMap[state] || 'bg-slate-800 text-slate-300 border-slate-700'
      ]}>
        {state}
      </span>
    </div>

    <!-- Description -->
    {description && (
      <p class="text-sm text-slate-300 mb-4 leading-relaxed line-clamp-3">
        {description}
      </p>
    )}

    <!-- Equipment Tags -->
    {equipment.length > 0 && (
      <div class="mb-4">
        <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Featured Implements</h4>
        <div class="flex flex-wrap gap-1.5">
          {equipment.map(item => (
            <span class="inline-flex items-center text-xs px-2.5 py-1 rounded bg-slate-800/80 text-slate-300 border border-slate-700/60 font-mono">
              {item}
            </span>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Footer Actions -->
  {website && (
    <div class="mt-4 pt-3 border-t border-slate-800/80 flex items-center justify-between">
      <a
        href={website}
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-semibold text-orange-400 hover:text-orange-300 inline-flex items-center gap-1 group/link"
      >
        <span>Visit Venue Website</span>
        <svg class="w-3.5 h-3.5 transform group-hover/link:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    </div>
  )}
</div>
